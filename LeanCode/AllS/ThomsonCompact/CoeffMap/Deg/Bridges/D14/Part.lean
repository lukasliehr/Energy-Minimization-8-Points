import ThomsonCompact.CoeffMap.Deg.Bridges.D14.Link
import ThomsonCompact.Interface.D14

/-!
# The W0 part of `Residual14` from per-cell leaves (F2h; generated by `CoeffMap/Deg/gen/assemble.py`)

`W0Part14 s cell blk hord N nb` bundles exactly the fields `B`, `g`, `B_valid`, `W0_link` of
`Interface.D14.Residual14` (any `m`, `t`). For decoded cell data `data` (the exporter's
`Cells/<cell>/W0.lean`), literal cell `data.cell` and blocks `blkOf14 data` (`F0 … F6`, then
`M0_plus … Mdet_standard`), `w0Part_of14` builds it with `nb = 15 · 32 · 32` pieces `ι = 32 (32 b + g) + h` from
the per-cell leaf facts (see `CoeffMap.Deg.W0Part`); `bsum_valid14` gives the combined model per coordinate
(`Bsum_valid` of `API.md`).
-/

noncomputable section
open scoped BigOperators

namespace ThomsonCompact.CoeffMap.Deg

open Blueprint.CAP Blueprint.Thomson Blueprint.Thomson.Finite ThomsonCompact.CoeffMap ThomsonCompact.Packed
open ThomsonCompact.CoeffMap.Deg.Link

/-- The `Residual14` fields produced by F2 (W0 contributions and their link to the Gram map). -/
structure W0Part14 (s : ℝ → ℝ) (cell : Literals.Cell) (blk : GramBlock 7 → Literals.Block)
    (hord : ∀ b, (blk b).order = gramBlockDimension 7 b) (N nb : ℕ) where
  B : Fin nb → Fin 145 → QModel N
  g : Fin nb → Fin 145 → ℝ → ℝ
  B_valid : ∀ b r, (B b r).asTM.Valid (g b r)
  W0_link : ∀ (x : ℝ) (hx : x ∈ cellDomain) (hs : 0 ≤ s x) (r : Fin 145),
    retainCompatible (aS (s x)) 14 (ThomsonCompact.Interface.D14.gramMap s x hs
      (ThomsonCompact.Interface.D14.W0 cell blk hord x hx)) (ThomsonCompact.FixedD14.retainedIndex r) = ∑ b, g b r x

/-- Transport of a `W0Part14` along an equality of exponent functions. -/
def W0Part14.congr {s s' : ℝ → ℝ} {cell : Literals.Cell} {blk : GramBlock 7 → Literals.Block}
    {hord : ∀ b, (blk b).order = gramBlockDimension 7 b} {N nb : ℕ} (P : W0Part14 s cell blk hord N nb)
    (h : ∀ x, s x = s' x) : W0Part14 s' cell blk hord N nb :=
  (funext h : s = s') ▸ P

/-- Literal blocks of decoded cell data in the D14 Gram block order. -/
abbrev blkOf14 (data : CellData) : GramBlock 7 → Literals.Block := blkOfD 7 data

/-- `hord` from the decoded block orders (one `decide`). -/
theorem hord_of14 (data : CellData)
    (h : (((List.range 7).all fun k => Nat.beq (data.order k) (7 - k)) &&
      ((List.range 8).all fun j => Nat.beq (data.order (7 + j)) (D14.L.gdim (7 + j)))) = true) :
    ∀ b, (blkOf14 data b).order = gramBlockDimension 7 b := by
  rw [Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
  intro b
  cases b with
  | inl k => exact Nat.eq_of_beq_eq_true (h.1 k.val (List.mem_range.mpr k.isLt))
  | inr sb =>
    show data.order (7 + sIdx sb) = scalarBlockDimension sb 7
    rw [Nat.eq_of_beq_eq_true (h.2 (sIdx sb) (List.mem_range.mpr (sIdx_lt sb)))]
    exact Bridges.D14.facts.gdim_sc sb

/-- The retained tags of the fixed D14 table are the tags of the W0 data. -/
theorem htag14 : ∀ r : Fin 145, (ThomsonCompact.FixedD14.retainedIndex r).val = D14.L.rtag r.val := by
  have h : (List.range 145).all (fun r => teq (ThomsonCompact.Fixed.D14.decodeTag
      (ThomsonCompact.Fixed.D14.ltab.rtag r)) (D14.L.rtag r)) = true := by decide +kernel
  intro r
  rw [ThomsonCompact.FixedD14.retainedIndex_tag]
  rw [List.all_eq_true] at h
  exact teq_eq (h r.val (List.mem_range.mpr r.isLt))

/-- The W0 Gram family of the interface has the literal Gram entries of the data. -/
theorem W0_entry14 (data : CellData) (hord : ∀ b, (blkOf14 data b).order = gramBlockDimension 7 b) (x : ℝ)
    (hx : x ∈ cellDomain) (b : GramBlock 7) (i j : Fin (gramBlockDimension 7 b)) :
    (ThomsonCompact.Interface.D14.W0 data.cell (blkOf14 data) hord x hx).val b i j =
      litW data (bIdx 7 b) i.val j.val x := by
  have ho : data.order (bIdx 7 b) = gramBlockDimension 7 b := hord b
  have hi : i.val < data.order (bIdx 7 b) := by rw [ho]; exact i.isLt
  have hj : j.val < data.order (bIdx 7 b) := by rw [ho]; exact j.isLt
  unfold litW
  rw [dif_pos ⟨hi, hj⟩]
  rfl

variable {N S B W : ℕ}

/-- **The W0 part of `Residual14` from the leaves of a cell** (`nb = 15 · 32 · 32`). -/
noncomputable def w0Part_of14 (hg : Good N S B W) (data : CellData) (s : ℝ → ℝ) {A : TM}
    (hA : Encl (mkCtx N S B W) A (fun x => aS (s x)))
    (hord : ∀ b, (blkOf14 data b).order = gramBlockDimension 7 b) (sd : SumD)
    (hden : D14.L.denOkD (mkCtx N S B W) A sd = true) (hnp : ∀ b, b < 15 → sd.np b ≤ 32)
    (PT : ℕ → ℕ → ℕ → ℕ → TM)
    (hP : ∀ b h, b < D14.L.dH + 8 → h < sd.np b → ∀ u v,
      EnclOk (mkCtx N S B W) (PT b h u v) (fun t => PfL D14.L (fun x => aS (s x)) data b u v t))
    (n : ℕ) (hpc : ∀ b g h r, b < D14.L.dH + 8 → g < D14.L.nGrp b → h < sd.np b → r < D14.L.nc →
      (TP D14.L sd (mkCtx N S B W) PT b g h r).ok = true ∧
        ckOk (mkCtx N S B W) sd.F n (TP D14.L sd (mkCtx N S B W) PT b g h r) (ckRecD sd n b g h r) = true) :
    W0Part14 s data.cell (blkOf14 data) hord N (15 * 32 * 32) where
  B ι r := BP D14.L sd (mkCtx N S B W) PT ι r
  g ι r := gP D14.L sd (fun x => aS (s x)) data ι r
  B_valid ι r := BP_valid D14.L sd _ data hg PT hP n hpc ι r r.isLt
  W0_link x hx hs r :=
    gP_link D14.L 7 (by norm_num) (by norm_num) ThomsonCompact.Interface.D14.pivots
      ThomsonCompact.Interface.D14.pivots_valid Bridges.D14.link hg s hA sd hden hnp data x hx hs
      (ThomsonCompact.Interface.D14.W0 data.cell (blkOf14 data) hord x hx) (W0_entry14 data hord x hx)
      (ThomsonCompact.FixedD14.retainedIndex r) r.val r.isLt (htag14 r)

/-- **The final W0 sums enclose the sum of the pieces** (one combined model per coordinate). -/
theorem bsum_valid14 (hg : Good N S B W) (data : CellData) (s : ℝ → ℝ) {A : TM}
    (hA : Encl (mkCtx N S B W) A (fun x => aS (s x)))
    (hord : ∀ b, (blkOf14 data b).order = gramBlockDimension 7 b) (sd : SumD)
    (hden : D14.L.denOkD (mkCtx N S B W) A sd = true) (hnp : ∀ b, b < 15 → sd.np b ≤ 32)
    (PT : ℕ → ℕ → ℕ → ℕ → TM)
    (hP : ∀ b h, b < D14.L.dH + 8 → h < sd.np b → ∀ u v,
      EnclOk (mkCtx N S B W) (PT b h u v) (fun t => PfL D14.L (fun x => aS (s x)) data b u v t))
    (n : ℕ) (hn : n ≤ N) (hpc : ∀ b g h r, b < D14.L.dH + 8 → g < D14.L.nGrp b → h < sd.np b → r < D14.L.nc →
      (TP D14.L sd (mkCtx N S B W) PT b g h r).ok = true ∧
        ckOk (mkCtx N S B W) sd.F n (TP D14.L sd (mkCtx N S B W) PT b g h r) (ckRecD sd n b g h r) = true)
    (hsum : ∀ r, r < 145 → D14.L.sumOkRD sd n r = true) (r : Fin 145) :
    (BsumD n S sd r).asTM.Valid
      (fun x => ∑ ι, (w0Part_of14 hg data s hA hord sd hden hnp PT hP n hpc).g ι r x) :=
  bsum_valid_gP D14.L 7 rfl
    (fun b hb => (nGrp_le D14.L b (Bridges.D14.link.checks b hb).grp).trans (by norm_num))
    hg sd _ data PT hP hnp n hn hpc r.val r.isLt (hsum r.val r.isLt)

#print axioms htag14
#print axioms w0Part_of14
#print axioms bsum_valid14

end ThomsonCompact.CoeffMap.Deg
