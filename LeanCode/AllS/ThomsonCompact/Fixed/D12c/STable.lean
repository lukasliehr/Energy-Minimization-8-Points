import ThomsonCompact.Fixed.Kernel
import ThomsonCompact.Fixed.KernelSem
import ThomsonCompact.Fixed.D12c.GTable
import ThomsonCompact.Fixed.D12c.LTable

/-! D12 semantic data (RF records, column scales, denominator cofactors, Q factors) (generated by `tools/f4_export.py`; encodings: `Fixed/Kernel.lean`). -/

namespace ThomsonCompact.Fixed.D12c

/-- column scales `S_{b,j}` (slot `64 b + j`) -/
noncomputable def scT (k : Nat) : Nat := fld  (Nat.mul 16 k) 16

/-- raw-tensor denominators -/
noncomputable def rdT (k : Nat) : Nat := fld 0x51000000010000000300000015 (Nat.mul 32 k) 32

noncomputable def rnumT_c : Nat → Nat
  | 0 => 
  | 1 => 
  | 2 => 
  | 3 => 
  | 4 => 
  | _ => 0

/-- RF numerator records (dense catalogue coefficients) -/
noncomputable def rnumT (k : Nat) : Nat := fld (rnumT_c (Nat.div k 53)) (Nat.mul 304 (Nat.mod k 53)) 304

/-- RF numerator scales -/
noncomputable def rscT (k : Nat) : Nat := fld  (Nat.mul 12 k) 12

/-- RF denominator index -/
noncomputable def rdiT (k : Nat) : Nat := fld 0xd6dd6dbadbadb74934926b6eb6dd6dd6dba49a49349349204924836db612492092490249275badbadd6dd26926b75b75badba4d24d269204920db612482490249b6db6d924b6db6d92492449249b6db492492492249240 (Nat.mul 3 k) 3

/-- RF denominator records -/
noncomputable def rdenT (k : Nat) : Nat := fld 0x702020000000000020858c909418180000000000002163242506050000000803fe01362c5cc241800200805ff72ade396730a07000002017fdcab78e59cc2818000000000000000000030201000 (Nat.mul 98 k) 98

/-- RF denominator scales -/
noncomputable def rdscT (k : Nat) : Nat := fld 0x4285e7cf981 (Nat.mul 7 k) 7

/-- cofactors: `den · cof = ρ δ_b` -/
noncomputable def rcofT (k : Nat) : Nat := fld 0x107dcb5050500000000000000000000c08040000000000000000000b020200000000000000000001c080800000000000000000003020100000000000000000002c080800200805ff72ade396730a07000 (Nat.mul 98 k) 98

/-- `ρ` (sign bit 0, magnitude `>> 1`) -/
noncomputable def rrhoT (k : Nat) : Nat := fld 0x2aaa (Nat.mul 2 k) 2

/-- block of the cofactor identity -/
noncomputable def rblkT (k : Nat) : Nat := fld 0x3030302020202 (Nat.mul 8 k) 8

/-- RF record of block 2, column `j`, raw row `u` (slot `j · nraw + u`) -/
noncomputable def col2T (k : Nat) : Nat := fld  (Nat.mul 10 k) 10

/-- RF record of block 3, column `j`, raw row `u` (slot `j · nraw + u`) -/
noncomputable def col3T (k : Nat) : Nat := fld  (Nat.mul 10 k) 10

/-- Q factors (primitive) -/
noncomputable def facT (k : Nat) : Nat := fld  (Nat.mul 392 k) 392

/-- Q factor exponents -/
noncomputable def fexpT (k : Nat) : Nat := fld 0x9050503030202010205 (Nat.mul 8 k) 8

noncomputable def colAll (b j u : Nat) : Nat :=
  bif Nat.beq b 2 then col2T (Nat.add (Nat.mul 23 j) u) else col3T (Nat.add (Nat.mul 27 j) u)

def ncolAll (b : Nat) : Nat := bif Nat.beq b 2 then 18 else bif Nat.beq b 3 then 20 else 0

def nrawAll (b : Nat) : Nat := bif Nat.beq b 2 then 23 else bif Nat.beq b 3 then 27 else 0

/-- Semantic data of D12. -/
noncomputable def stab : STab where
  sc := fun b j => scT (Nat.add (Nat.mul 64 b) j)
  rd := rdT
  rnum := rnumT
  rsc := rscT
  rdi := rdiT
  rden := rdenT
  rdsc := rdscT
  rcof := rcofT
  rrho := rrhoT
  rblk := rblkT
  nden := 7
  col := colAll
  ncol := ncolAll
  nraw := nrawAll
  LN := 12
  wN := 23
  LD := 7
  wD := 10
  LC := 7
  wC := 10
  fac := facT
  fexp := fexpT
  nfac := 10
  fsgn := false

end ThomsonCompact.Fixed.D12c
