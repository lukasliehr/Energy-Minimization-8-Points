  decide +kernel

theorem weighted_sound (u v t : ℝ) :
    (Data.S7_even.weightedProduct 0 0).eval u v t=cachedProduct.eval u v t := by
  have hcd : (r2019*r2019 : ℚ)=r2020 := by decide +kernel
  exact Block.sos_scaled_product Data.S7_even 0 0 r2019 r2019 sourceLeft sourceRight
    partial0 cachedProduct
    (fun u v t => Poly.eval_eq_of_check _ _ left_checked u v t)
    (fun u v t => Poly.eval_eq_of_check _ _ right_checked u v t)
    partial_sound0 (by simpa only [hcd] using weighted_checked) u v t

theorem symmetry_checked :
    (Poly.add (Poly.scale (K.ofRat (if 0=0 then 1 else 2)) (Poly.symmetrize cachedProduct))
      (Poly.scale (K.ofRat (-1)) (expandColumn coefficients))).isZero := by
  decide +kernel

theorem sound (u v t : ℝ) :
    (Data.S7_even.upperColumn 0 0).eval u v t =
      (expandColumn coefficients).eval u v t :=
  Block.sos_cached_sound_of_eq _ rfl _ _ _ _ weighted_sound symmetry_checked u v t

end Coulomb8.Columns.C150

