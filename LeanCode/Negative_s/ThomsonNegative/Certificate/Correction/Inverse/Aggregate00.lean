theorem shift_row_0 (j : Fin 68) : shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 j) (shiftANumerator 0 j)=true := by
  have hj := j.isLt
  by_cases h0 : j.val<19
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 0 19 shift_checked_0_0 j (by omega) h0
  by_cases h1 : j.val<27
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 19 8 shift_checked_0_1 j (by omega) h1
  by_cases h2 : j.val<35
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 27 8 shift_checked_0_2 j (by omega) h2
  by_cases h3 : j.val<43
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 35 8 shift_checked_0_3 j (by omega) h3
  by_cases h4 : j.val<51
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 43 8 shift_checked_0_4 j (by omega) h4
  by_cases h5 : j.val<59
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 51 8 shift_checked_0_5 j (by omega) h5
  exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 0 k) (shiftANumerator 0 k)) 59 9 shift_checked_0_6 j (by omega) (by omega)
