theorem shift_row_24 (j : Fin 68) : shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 24 j) (shiftANumerator 24 j)=true := by
  have hj := j.isLt
  by_cases h0 : j.val<41
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 24 k) (shiftANumerator 24 k)) 0 41 shift_checked_24_0 j (by omega) h0
  by_cases h1 : j.val<62
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 24 k) (shiftANumerator 24 k)) 41 21 shift_checked_24_1 j (by omega) h1
  exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 24 k) (shiftANumerator 24 k)) 62 6 shift_checked_24_2 j (by omega) (by omega)
theorem lift_row_24 (j : Fin 68) : (liftEquation 24 j).check=true := allBelow_spec _ _ lifts_checked_24 j j.isLt
theorem inverse_row_24 (j : Fin 68) : (inverseEquation 24 j).check=true := by
  have hj := j.isLt
  by_cases h0 : j.val<8
