      (Poly.scale (K.ofRat (-1)) value_F2_2)).isZero := by
  decide +kernel

theorem sound_F2_2 (u v t : ℝ) :
    (Data.F2.component 2).eval u v t = value_F2_2.eval u v t :=
  Poly.eval_eq_of_check _ _ check_F2_2 u v t

