theorem entry_bound (i : Fin 99) : |residual i| ≤ (1/36028797018963968 : ℝ) := by
  have hb : List.Forall₂ Dyadic.Contains (rowBoxes i)
      (List.ofFn (fun c => CoefficientMatrix.matrix (Witness.rows i) c)) := by
    rw [rowBoxes_eq]
    exact Dyadic.forall₂_ofFn _ _ _ (fun c => CoefficientMatrix.contains _ _)
  have he := Dyadic.linear_error_bound centerList (d:=2^96) (E:=2^169)
    (by norm_num) hb (targetBoxes_contains i) (checked i)
  rw [residual_eq]
  norm_num [Dyadic.scale] at he ⊢
  exact he

theorem norm_bound : ‖residual‖ ≤ (1/36028797018963968 : ℝ) := by
  apply (pi_norm_le_iff_of_nonneg (by norm_num)).mpr
  intro i
  simpa only [Real.norm_eq_abs] using entry_bound i

