/-- Entry `(u, v, neg, m)` from its slot. -/
def decodeEntry (x : Nat) : Nat × Nat × Bool × Nat :=
  (Nat.land x 255, Nat.land (Nat.shiftRight x 8) 255, Nat.beq (Nat.land (Nat.shiftRight x 16) 1) 1,
    Nat.shiftRight x 17)

/-- Entry `k` of block `b`. -/
noncomputable def eAt (b k : Nat) : Nat := slotAt 32 (entChunk b (Nat.shiftRight k 9)) (Nat.land k 511)

/-- `count` entries of block `b` from index `s`. -/
noncomputable def eRun (b : Nat) : Nat → Nat → List (Nat × Nat × Bool × Nat)
  | 0, _ => []
  | count + 1, s => decodeEntry (eAt b s) :: eRun b count (s + 1)

/-- The sparse coefficient list of block `b` at retained coordinate `r`. -/
noncomputable def eList (b r : Nat) : List (Nat × Nat × Bool × Nat) :=
  eRun b (slotAt 16 (offs b) (r + 1) - slotAt 16 (offs b) r) (slotAt 16 (offs b) r)

