/-! ### cell finite_d14_c18 (index 19, D = 14, profile m = [1, 6, 4, 2, 2]) -/
namespace ThomsonCompact.Target.Cells.finited14c18
open Blueprint.CAP.ArithmeticPilot.finite_d14_c18_RootCompositionGates (heightFinal)
open Blueprint.CAP.Instances.finite_d14_c18_RootAccepted (exponent sound domain)
open Blueprint.CAP.ArithmeticPilot.RootControlsAll_finite_d14_c18 (center halfwidth)

abbrev c : Ctx := mkCtx 28 256 264 530
theorem good : Good 28 256 264 530 := good_prod 28 (by decide +kernel)

/-- the old accepted height model, packed by the reverse bridge -/
theorem hA_old : Encl c (ofOldTM c heightFinal.asTM) (fun x => aS (exponent x)) :=
  ofBoxes_sound good _ sound.1 (by decide +kernel)

theorem A_fields : (ofOldTM c heightFinal.asTM).v = Bench.finited14c18.A.v ∧ (ofOldTM c heightFinal.asTM).a = Bench.finited14c18.A.a ∧
    (ofOldTM c heightFinal.asTM).s = Bench.finited14c18.A.s ∧ (ofOldTM c heightFinal.asTM).e = Bench.finited14c18.A.e := by
  decide +kernel

theorem hA : Encl c Bench.finited14c18.A (fun x => aS (exponent x)) :=
  hA_old.of_fields A_fields.1.symm A_fields.2.1.symm A_fields.2.2.1.symm A_fields.2.2.2.symm

/-- the exponent `s = center + halfwidth x` as an old point-polynomial model -/
noncomputable def Maff : Blueprint.CAP.TM 1 := Blueprint.CAP.TM.pointPolynomial ![center, halfwidth]

theorem hs_old : Encl c (ofOldTM c Maff) (fun x => exponent x) := by
  refine (ofBoxes_sound good Maff (Blueprint.CAP.TM.pointPolynomial_valid _) (by decide +kernel)).congr
    (fun x _ => ?_)
  simp [scalarEval, exponent, Fin.sum_univ_two]

theorem s_fields : (ofOldTM c Maff).v = Bench.finited14c18.sT.v ∧ (ofOldTM c Maff).a = Bench.finited14c18.sT.a ∧
    (ofOldTM c Maff).s = Bench.finited14c18.sT.s ∧ (ofOldTM c Maff).e = Bench.finited14c18.sT.e := by
  decide +kernel

theorem hs : Encl c Bench.finited14c18.sT (fun x => exponent x) :=
  hs_old.of_fields s_fields.1.symm s_fields.2.1.symm s_fields.2.2.1.symm s_fields.2.2.2.symm

theorem hm : Profile.Valid 14 ![1, 6, 4, 2, 2] := ⟨by simp [Fin.sum_univ_succ], by decide⟩

/-- **the D14 target enclosures of the cell**: `hfun exponent m j x = (hermitePolynomial (exponent x)
(aS (exponent x)) m).coeff (j+1)` (`= CoeffMap.D12.hfun` for D = 12) -/
theorem target_encl (j : Fin 14) :
    Encl c ((targetCoeffsU c Bench.finited14c18.P [1, 6, 4, 2, 2] Bench.finited14c18.sT Bench.finited14c18.A).getD (j.val + 1) zeroTM)
      (fun x => (hermitePolynomial (exponent x) (aS (exponent x)) ![1, 6, 4, 2, 2]).coeff (j.val + 1)) :=
  targetTMs14_sound good (by norm_num) hs (fun x hx => (domain x hx).1) hA Bench.finited14c18.P (by decide) ![1, 6, 4, 2, 2] hm
    Bench.finited14c18.ok j

#print axioms target_encl

end ThomsonCompact.Target.Cells.finited14c18

