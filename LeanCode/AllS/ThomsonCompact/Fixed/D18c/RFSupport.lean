/-! D18 RF support (generated by `tools/f4_export.py`): `rfRawColumn_eq` (an old raw column over decoded records is a
`Fin`-sum, as F2's `CoeffMap.ColumnSupport`) and the scalar block dimensions of the corrected scalar blocks. -/

namespace ThomsonCompact.Fixed.D18c

open Blueprint.CAP Blueprint.Thomson.Finite ThomsonCompact.CoeffMap

theorem rfRawColumn_eq (a : ℝ) (n : ℕ) (rs : Fin n → RFRec) (f : Fin n → Poly3) :
    RFBridge.rfRawColumn a ((List.finRange n).map fun u => (rs u).toRatFun) ((List.finRange n).map f) =
      ∑ u, MvPolynomial.C ((rs u).value a) * f u := by
  simp only [RFBridge.rfRawColumn, List.zipWith_map, List.zipWith_self, RFRec.eval_toRatFun]
  rw [Fin.sum_univ_def]

theorem dims_m0Plus : scalarBlockDimension .m0Plus 9 = 48 := by
  simp only [scalarBlockDimension, standardTagList, invariantPivots, signPivots, standardPivots, parityPivots,
    Nat.reduceSub, Bool.false_eq_true, if_false, if_true, RawCatalogue.invariantTagList_1, RawCatalogue.invariantTagList_2, RawCatalogue.invariantTagList_3, RawCatalogue.invariantTagList_4, RawCatalogue.invariantTagList_5, RawCatalogue.invariantTagList_6, RawCatalogue.invariantTagList_7, RawCatalogue.invariantTagList_8, RawCatalogue.invariantTagList_9]
  decide +kernel

theorem dims_m0Standard : scalarBlockDimension .m0Standard 9 = 65 := by
  simp only [scalarBlockDimension, standardTagList, invariantPivots, signPivots, standardPivots, parityPivots,
    Nat.reduceSub, Bool.false_eq_true, if_false, if_true, RawCatalogue.invariantTagList_1, RawCatalogue.invariantTagList_2, RawCatalogue.invariantTagList_3, RawCatalogue.invariantTagList_4, RawCatalogue.invariantTagList_5, RawCatalogue.invariantTagList_6, RawCatalogue.invariantTagList_7, RawCatalogue.invariantTagList_8, RawCatalogue.invariantTagList_9]
  decide +kernel

#print axioms dims_m0Standard

end ThomsonCompact.Fixed.D18c
