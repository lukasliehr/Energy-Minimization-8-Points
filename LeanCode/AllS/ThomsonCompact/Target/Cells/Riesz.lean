/-! ### cell finite_d16_c56 (index 26, D = 16, profile m = [1, 2, 10, 2, 2]) -/
namespace ThomsonCompact.Target.Cells.finited16c56
open Blueprint.CAP.ArithmeticPilot.finite_d16_c56_RootCompositionGates (heightFinal)
open Blueprint.CAP.Instances.finite_d16_c56_RootAccepted (exponent sound domain)
open Blueprint.CAP.ArithmeticPilot.RootControlsAll_finite_d16_c56 (center halfwidth)

abbrev c : Ctx := mkCtx 25 256 264 530
theorem good : Good 25 256 264 530 := good_prod 25 (by decide +kernel)

/-- the old accepted height model, packed by the reverse bridge -/
theorem hA_old : Encl c (ofOldTM c heightFinal.asTM) (fun x => aS (exponent x)) :=
  ofBoxes_sound good _ sound.1 (by decide +kernel)

theorem A_fields : (ofOldTM c heightFinal.asTM).v = Bench.finited16c56.A.v ∧ (ofOldTM c heightFinal.asTM).a = Bench.finited16c56.A.a ∧
    (ofOldTM c heightFinal.asTM).s = Bench.finited16c56.A.s ∧ (ofOldTM c heightFinal.asTM).e = Bench.finited16c56.A.e := by
  decide +kernel

theorem hA : Encl c Bench.finited16c56.A (fun x => aS (exponent x)) :=
  hA_old.of_fields A_fields.1.symm A_fields.2.1.symm A_fields.2.2.1.symm A_fields.2.2.2.symm

/-- the exponent `s = center + halfwidth x` as an old point-polynomial model -/
noncomputable def Maff : Blueprint.CAP.TM 1 := Blueprint.CAP.TM.pointPolynomial ![center, halfwidth]

theorem hs_old : Encl c (ofOldTM c Maff) (fun x => exponent x) := by
  refine (ofBoxes_sound good Maff (Blueprint.CAP.TM.pointPolynomial_valid _) (by decide +kernel)).congr
    (fun x _ => ?_)
  simp [scalarEval, exponent, Fin.sum_univ_two]

theorem s_fields : (ofOldTM c Maff).v = Bench.finited16c56.sT.v ∧ (ofOldTM c Maff).a = Bench.finited16c56.sT.a ∧
    (ofOldTM c Maff).s = Bench.finited16c56.sT.s ∧ (ofOldTM c Maff).e = Bench.finited16c56.sT.e := by
  decide +kernel

theorem hs : Encl c Bench.finited16c56.sT (fun x => exponent x) :=
  hs_old.of_fields s_fields.1.symm s_fields.2.1.symm s_fields.2.2.1.symm s_fields.2.2.2.symm

theorem hm : Profile.Valid 16 ![1, 2, 10, 2, 2] := ⟨by simp [Fin.sum_univ_succ], by decide⟩

/-- **the Riesz-balanced D16 target enclosures of the cell**: `hfunR 56 exponent m j x =
balancedMultiplier 56 (exponent x) · (hermitePolynomial (exponent x) (aS (exponent x)) m).coeff (j+1)` -/
theorem target_encl (j : Fin 16) :
    Encl c ((targetCoeffs c Bench.finited16c56.P [1, 2, 10, 2, 2] Bench.finited16c56.sT Bench.finited16c56.A).getD (j.val + 1) zeroTM) (hfunR 56 exponent ![1, 2, 10, 2, 2] j) := by
  have h := targetTMsR_sound good (by norm_num) hs (fun x hx => (domain x hx).1) hA Bench.finited16c56.P (by decide)
    ![1, 2, 10, 2, 2] hm Bench.finited16c56.ok j
  have hc : ((Bench.finited16c56.P.cR : ℕ) : ℝ) = 56 := by rw [show Bench.finited16c56.P.cR = 56 from rfl]; norm_num
  exact h.congr (fun x _ => by rw [hc])

#print axioms target_encl

end ThomsonCompact.Target.Cells.finited16c56

