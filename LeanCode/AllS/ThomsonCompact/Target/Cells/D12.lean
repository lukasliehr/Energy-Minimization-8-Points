/-! ### cell base_A_01 (index 0, D = 12, profile m = [5, 2, 2, 2, 2]) -/
namespace ThomsonCompact.Target.Cells.baseA01
open Blueprint.CAP.ArithmeticPilot.base_A_01_RootCompositionGates (heightFinal)
open Blueprint.CAP.Instances.base_A_01_RootAccepted (exponent sound domain)
open Blueprint.CAP.ArithmeticPilot.RootControlsAll_base_A_01 (center halfwidth)

abbrev c : Ctx := mkCtx 12 256 264 530
theorem good : Good 12 256 264 530 := good12

/-- the old accepted height model, packed by the reverse bridge -/
theorem hA_old : Encl c (ofOldTM c heightFinal.asTM) (fun x => aS (exponent x)) :=
  ofBoxes_sound good _ sound.1 (by decide +kernel)

theorem A_fields : (ofOldTM c heightFinal.asTM).v = Bench.baseA01.A.v ∧ (ofOldTM c heightFinal.asTM).a = Bench.baseA01.A.a ∧
    (ofOldTM c heightFinal.asTM).s = Bench.baseA01.A.s ∧ (ofOldTM c heightFinal.asTM).e = Bench.baseA01.A.e := by
  decide +kernel

theorem hA : Encl c Bench.baseA01.A (fun x => aS (exponent x)) :=
  hA_old.of_fields A_fields.1.symm A_fields.2.1.symm A_fields.2.2.1.symm A_fields.2.2.2.symm

/-- the exponent `s = center + halfwidth x` as an old point-polynomial model -/
noncomputable def Maff : Blueprint.CAP.TM 1 := Blueprint.CAP.TM.pointPolynomial ![center, halfwidth]

theorem hs_old : Encl c (ofOldTM c Maff) (fun x => exponent x) := by
  refine (ofBoxes_sound good Maff (Blueprint.CAP.TM.pointPolynomial_valid _) (by decide +kernel)).congr
    (fun x _ => ?_)
  simp [scalarEval, exponent, Fin.sum_univ_two]

theorem s_fields : (ofOldTM c Maff).v = Bench.baseA01.sT.v ∧ (ofOldTM c Maff).a = Bench.baseA01.sT.a ∧
    (ofOldTM c Maff).s = Bench.baseA01.sT.s ∧ (ofOldTM c Maff).e = Bench.baseA01.sT.e := by
  decide +kernel

theorem hs : Encl c Bench.baseA01.sT (fun x => exponent x) :=
  hs_old.of_fields s_fields.1.symm s_fields.2.1.symm s_fields.2.2.1.symm s_fields.2.2.2.symm

theorem hm : Profile.Valid 12 ![5, 2, 2, 2, 2] := ⟨by simp [Fin.sum_univ_succ], by decide⟩

/-- **the D12 target enclosures of the cell**: `hfun exponent m j x = (hermitePolynomial (exponent x)
(aS (exponent x)) m).coeff (j+1)` (`= CoeffMap.D12.hfun` for D = 12) -/
theorem target_encl (j : Fin 12) :
    Encl c ((targetCoeffsU c Bench.baseA01.P [5, 2, 2, 2, 2] Bench.baseA01.sT Bench.baseA01.A).getD (j.val + 1) zeroTM)
      (fun x => (hermitePolynomial (exponent x) (aS (exponent x)) ![5, 2, 2, 2, 2]).coeff (j.val + 1)) :=
  targetTMs_sound good (by norm_num) hs (fun x hx => (domain x hx).1) hA Bench.baseA01.P (by decide) ![5, 2, 2, 2, 2] hm
    Bench.baseA01.ok j

#print axioms target_encl

end ThomsonCompact.Target.Cells.baseA01

