noncomputable def blockIndex : Nat → Nat → Nat → Nat
  | 0, i, j => (blockIndices0.getD i []).getD j 68
  | 1, i, j => (blockIndices1.getD i []).getD j 68
  | 6, i, j => (blockIndices6.getD i []).getD j 68
  | 7, i, j => (blockIndices7.getD i []).getD j 68
  | _, _, _ => 68

theorem blockIndex_at_repair (r : Fin 68) :
    blockIndex (repairCoordinate r).1 (repairCoordinate r).2.1 (repairCoordinate r).2.2=r.val := by decide +kernel +revert

theorem repair_at_blockIndex (b : Fin 8) (i j : Fin (blockSize b)) :
    blockIndex b i j=68 ∨
      (blockIndex b i j<68 ∧ repairCoordinate (blockIndex b i j)=(b.val,min i.val j.val,max i.val j.val)) := by decide +kernel +revert

theorem blockIndex_symmetric (b : Fin 8) (i j : Fin (blockSize b)) :
    blockIndex b i j=blockIndex b j i := by decide +kernel +revert

theorem repair_rows_distinct (r s : Fin 68) :
    repairCoordinate r=repairCoordinate s → r=s := by decide +kernel +revert

theorem repair_bounded (r : Fin 68) :
    (repairCoordinate r).1<8 ∧
    (repairCoordinate r).2.1<blockSize (repairCoordinate r).1 ∧
    (repairCoordinate r).2.2<blockSize (repairCoordinate r).1 := by decide +kernel +revert

