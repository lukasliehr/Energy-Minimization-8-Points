theorem inverseRows_eq (i : Fin 99) :
    List.ofFn (Witness.inverseNumerators i)=Witness.inverseRows i :=
  Dyadic.ofFn_getD_of_length 0 (Witness.inverseRows i) (Witness.inverseRows_length i)

theorem entry_bound_of_check (i j : Fin 99)
    (h : Dyadic.errorNumerator (Witness.inverseRows i) (columns j)
      (Dyadic.identityBox i j) (2^40) ≤ 2^160) :
    |((1-Witness.preconditioner*selectedMatrix) i j)| ≤ (1/256 : ℝ) := by
  have he := Dyadic.inverse_entry_bound selectedMatrix (Witness.inverseNumerators i)
    (columns j) i j (columns_contains j) (by simpa only [inverseRows_eq] using h)
  exact he

