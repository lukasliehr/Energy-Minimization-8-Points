  decide +kernel

theorem sound_S6_trivial_2_R2 (u v t : ℝ) :
    (Data.S6_trivial.rowComponent 2 2).eval u v t = value_S6_trivial_2_R2.eval u v t :=
  by
    rw [s6PlainRow_sound ⟨2,by decide⟩]
    exact Poly.eval_eq_of_check _ _ check_S6_trivial_2_R2 u v t

