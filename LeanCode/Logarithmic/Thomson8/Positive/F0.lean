theorem C_row_0 : ∀ j : Fin 6,
    (Box.matmul 6 PW Data.F0.PBox.transpose) ⟨0,by decide⟩ j = C ⟨0,by decide⟩ j := by
  decide +kernel

theorem C_row_1 : ∀ j : Fin 6,
    (Box.matmul 6 PW Data.F0.PBox.transpose) ⟨1,by decide⟩ j = C ⟨1,by decide⟩ j := by
  decide +kernel

theorem C_row_2 : ∀ j : Fin 6,
    (Box.matmul 6 PW Data.F0.PBox.transpose) ⟨2,by decide⟩ j = C ⟨2,by decide⟩ j := by
  decide +kernel

theorem C_row_3 : ∀ j : Fin 6,
    (Box.matmul 6 PW Data.F0.PBox.transpose) ⟨3,by decide⟩ j = C ⟨3,by decide⟩ j := by
  decide +kernel

theorem C_row_4 : ∀ j : Fin 6,
    (Box.matmul 6 PW Data.F0.PBox.transpose) ⟨4,by decide⟩ j = C ⟨4,by decide⟩ j := by
  decide +kernel

theorem C_row_5 : ∀ j : Fin 6,
    (Box.matmul 6 PW Data.F0.PBox.transpose) ⟨5,by decide⟩ j = C ⟨5,by decide⟩ j := by
  decide +kernel

theorem C_eq : (Box.matmul 6 PW Data.F0.PBox.transpose) = C := by
  funext i j
  fin_cases i
  · exact C_row_0 j
  · exact C_row_1 j
  · exact C_row_2 j
  · exact C_row_3 j
  · exact C_row_4 j
  · exact C_row_5 j

theorem W_contains : ∀ i j, (W i j).Contains (Data.F0.matrix i j) := by
  intro i j
  rw [← W_eq]
  exact Data.F0.matrixBox_contains i j

theorem PW_contains : ∀ i j, (PW i j).Contains ((Data.F0.P*Data.F0.matrix) i j) := by
  intro i j
  rw [← PW_eq]
  exact Box.contains_matmul _ _ _ _ _ Data.F0.PBox_contains W_contains i j

theorem C_contains : ∀ i j, (C i j).Contains ((Data.F0.P*Data.F0.matrix*Data.F0.P.transpose) i j) := by
  intro i j
  rw [← C_eq]
  exact Box.contains_matmul _ _ _ _ _ PW_contains (fun i j => Data.F0.PBox_contains j i) i j

theorem rows_checked : ∀ i : Fin 6, Box.rowError 6 C i ≤ 1/2 := by
  decide +kernel

end Thomson8.Positive.F0Cache

namespace Thomson8.Positive
theorem F0_positive : Data.F0.matrix.PosDef :=
  Data.F0.positive_of_enclosure F0Cache.C F0Cache.C_contains F0Cache.rows_checked

#print axioms F0_positive

