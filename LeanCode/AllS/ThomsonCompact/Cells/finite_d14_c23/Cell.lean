theorem hboxPL : ∀ y ∈ cellDomain, ∃ t ∈ Set.Icc (-1 : ℝ) 1,
    aS (exponent ((y + sgnH true) / 2)) = tab14.a0 + tab14.σ * ThomsonCompact.Cells.C_finite_d14_c23_PL.B.cb.uf t :=
  box_of_piece14 ThomsonCompact.Target.Cells.finited14c23.good ThomsonCompact.Target.Cells.finited14c23.hA true (by norm_num) ThomsonCompact.Cells.C_finite_d14_c23_PL.B.cb ThomsonCompact.Cells.C_finite_d14_c23_PL.B.acN ThomsonCompact.Cells.C_finite_d14_c23_PL.B.rg ThomsonCompact.Cells.C_finite_d14_c23_PL.B.Leaves.height (by decide +kernel)
    (by decide +kernel) (by decide +kernel)

theorem cellFactsPL : CellFactsT tab14 (fun y => exponent ((y + sgnH true) / 2)) ThomsonCompact.Cells.C_finite_d14_c23_PL.B.cb ThomsonCompact.Floor.Tables.D14b.row where
  chan := ThomsonCompact.Cells.C_finite_d14_c23_PL.B.Leaves.chan
  good := ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩
  wc1 := by decide +kernel
  rows := ThomsonCompact.Floor.Tables.D14b.rowFacts
  s_nonneg := fun y hy => s_nonneg _ (half_memX true hy)
  box := hboxPL

theorem hcenPL : ∀ (r : Fin 145) (y : ℝ), scalarEval (fun k => (center r k : ℝ)) ((y + sgnH true) / 2) =
    scalarEval (fun k => (pieceCenter ThomsonCompact.Cells.C_finite_d14_c23_PL.B.cb ThomsonCompact.Cells.C_finite_d14_c23_PL.B.Sc r k : ℝ)) y :=
  fun r y => hcen_of_reexps [(0, 49), (49, 49), (98, 47)] (by decide +kernel)
    (fun p hp => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
