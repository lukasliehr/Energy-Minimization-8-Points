import ThomsonCompact.CoeffMap.Deg.Bridges.D18.Link
import ThomsonCompact.Interface.D18

/-!
# The W0 part of `Residual18` from per-cell leaves (F2h; generated by `CoeffMap/Deg/gen/assemble.py`)

`W0Part18 s cell blk hord N nb` bundles exactly the fields `B`, `g`, `B_valid`, `W0_link` of
`Interface.D18.Residual18` (any `m`, `t`, `β`). For decoded cell data `data` (the exporter's
`Cells/<cell>/W0.lean`), literal cell `data.cell` and blocks `blkOf18 data` (`F0 … F8`, then
`M0_plus … Mdet_standard`), `w0Part_of18` builds it with `nb = 17 · 32 · 32` pieces `ι = 32 (32 b + g) + h` from
the per-cell leaf facts (see `CoeffMap.Deg.W0Part`); `bsum_valid18` gives the combined model per coordinate
(`Bsum_valid` of `API.md`).
-/

noncomputable section
open scoped BigOperators

namespace ThomsonCompact.CoeffMap.Deg

open Blueprint.CAP Blueprint.Thomson Blueprint.Thomson.Finite ThomsonCompact.CoeffMap ThomsonCompact.Packed
open ThomsonCompact.CoeffMap.Deg.Link

/-- The `Residual18` fields produced by F2 (W0 contributions and their link to the Gram map). -/
structure W0Part18 (s : ℝ → ℝ) (cell : Literals.Cell) (blk : GramBlock 9 → Literals.Block)
    (hord : ∀ b, (blk b).order = gramBlockDimension 9 b) (N nb : ℕ) where
  B : Fin nb → Fin 272 → QModel N
  g : Fin nb → Fin 272 → ℝ → ℝ
  B_valid : ∀ b r, (B b r).asTM.Valid (g b r)
  W0_link : ∀ (x : ℝ) (hx : x ∈ cellDomain) (hs : 0 ≤ s x) (r : Fin 272),
    retainCompatible (aS (s x)) 18 (ThomsonCompact.Interface.D18.gramMap s x hs
      (ThomsonCompact.Interface.D18.W0 cell blk hord x hx)) (FixedTables.D18.retainedIndex r) = ∑ b, g b r x

/-- Transport of a `W0Part18` along an equality of exponent functions. -/
def W0Part18.congr {s s' : ℝ → ℝ} {cell : Literals.Cell} {blk : GramBlock 9 → Literals.Block}
    {hord : ∀ b, (blk b).order = gramBlockDimension 9 b} {N nb : ℕ} (P : W0Part18 s cell blk hord N nb)
    (h : ∀ x, s x = s' x) : W0Part18 s' cell blk hord N nb :=
  (funext h : s = s') ▸ P

/-- Literal blocks of decoded cell data in the D18 Gram block order. -/
abbrev blkOf18 (data : CellData) : GramBlock 9 → Literals.Block := blkOfD 9 data

/-- `hord` from the decoded block orders (one `decide`). -/
theorem hord_of18 (data : CellData)
    (h : (((List.range 9).all fun k => Nat.beq (data.order k) (9 - k)) &&
      ((List.range 8).all fun j => Nat.beq (data.order (9 + j)) (D18.L.gdim (9 + j)))) = true) :
    ∀ b, (blkOf18 data b).order = gramBlockDimension 9 b := by
  rw [Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
  intro b
  cases b with
  | inl k => exact Nat.eq_of_beq_eq_true (h.1 k.val (List.mem_range.mpr k.isLt))
  | inr sb =>
    show data.order (9 + sIdx sb) = scalarBlockDimension sb 9
    rw [Nat.eq_of_beq_eq_true (h.2 (sIdx sb) (List.mem_range.mpr (sIdx_lt sb)))]
    exact Bridges.D18.facts.gdim_sc sb

/-- The retained tags of the fixed D18 table are the tags of the W0 data. -/
theorem htag18 : ∀ r : Fin 272, (FixedTables.D18.retainedIndex r).val = D18.L.rtag r.val := by
  have h : (List.finRange 272).all (fun r => teq (FixedTables.D18.coordinateTags r) (D18.L.rtag r.val)) = true := by
    decide +kernel
  intro r
  rw [FixedTables.D18.retainedIndex_tag]
  rw [List.all_eq_true] at h
  exact teq_eq (h r (List.mem_finRange r))

/-- The W0 Gram family of the interface has the literal Gram entries of the data. -/
theorem W0_entry18 (data : CellData) (hord : ∀ b, (blkOf18 data b).order = gramBlockDimension 9 b) (x : ℝ)
    (hx : x ∈ cellDomain) (b : GramBlock 9) (i j : Fin (gramBlockDimension 9 b)) :
    (ThomsonCompact.Interface.D18.W0 data.cell (blkOf18 data) hord x hx).val b i j =
      litW data (bIdx 9 b) i.val j.val x := by
  have ho : data.order (bIdx 9 b) = gramBlockDimension 9 b := hord b
  have hi : i.val < data.order (bIdx 9 b) := by rw [ho]; exact i.isLt
  have hj : j.val < data.order (bIdx 9 b) := by rw [ho]; exact j.isLt
  unfold litW
  rw [dif_pos ⟨hi, hj⟩]
  rfl

variable {N S B W : ℕ}

/-- **The W0 part of `Residual18` from the leaves of a cell** (`nb = 17 · 32 · 32`). -/
noncomputable def w0Part_of18 (hg : Good N S B W) (data : CellData) (s : ℝ → ℝ) {A : TM}
    (hA : Encl (mkCtx N S B W) A (fun x => aS (s x)))
    (hord : ∀ b, (blkOf18 data b).order = gramBlockDimension 9 b) (sd : SumD)
    (hden : D18.L.denOkD (mkCtx N S B W) A sd = true) (hnp : ∀ b, b < 17 → sd.np b ≤ 32)
    (PT : ℕ → ℕ → ℕ → ℕ → TM)
    (hP : ∀ b h, b < D18.L.dH + 8 → h < sd.np b → ∀ u v,
      EnclOk (mkCtx N S B W) (PT b h u v) (fun t => PfL D18.L (fun x => aS (s x)) data b u v t))
    (n : ℕ) (hpc : ∀ b g h r, b < D18.L.dH + 8 → g < D18.L.nGrp b → h < sd.np b → r < D18.L.nc →
      (TP D18.L sd (mkCtx N S B W) PT b g h r).ok = true ∧
        ckOk (mkCtx N S B W) sd.F n (TP D18.L sd (mkCtx N S B W) PT b g h r) (ckRecD sd n b g h r) = true) :
    W0Part18 s data.cell (blkOf18 data) hord N (17 * 32 * 32) where
  B ι r := BP D18.L sd (mkCtx N S B W) PT ι r
  g ι r := gP D18.L sd (fun x => aS (s x)) data ι r
  B_valid ι r := BP_valid D18.L sd _ data hg PT hP n hpc ι r r.isLt
  W0_link x hx hs r :=
    gP_link D18.L 9 (by norm_num) (by norm_num) ThomsonCompact.Interface.D18.pivots
      ThomsonCompact.Interface.D18.pivots_valid Bridges.D18.link hg s hA sd hden hnp data x hx hs
      (ThomsonCompact.Interface.D18.W0 data.cell (blkOf18 data) hord x hx) (W0_entry18 data hord x hx)
      (FixedTables.D18.retainedIndex r) r.val r.isLt (htag18 r)

/-- **The final W0 sums enclose the sum of the pieces** (one combined model per coordinate). -/
theorem bsum_valid18 (hg : Good N S B W) (data : CellData) (s : ℝ → ℝ) {A : TM}
    (hA : Encl (mkCtx N S B W) A (fun x => aS (s x)))
    (hord : ∀ b, (blkOf18 data b).order = gramBlockDimension 9 b) (sd : SumD)
    (hden : D18.L.denOkD (mkCtx N S B W) A sd = true) (hnp : ∀ b, b < 17 → sd.np b ≤ 32)
    (PT : ℕ → ℕ → ℕ → ℕ → TM)
    (hP : ∀ b h, b < D18.L.dH + 8 → h < sd.np b → ∀ u v,
      EnclOk (mkCtx N S B W) (PT b h u v) (fun t => PfL D18.L (fun x => aS (s x)) data b u v t))
    (n : ℕ) (hn : n ≤ N) (hpc : ∀ b g h r, b < D18.L.dH + 8 → g < D18.L.nGrp b → h < sd.np b → r < D18.L.nc →
      (TP D18.L sd (mkCtx N S B W) PT b g h r).ok = true ∧
        ckOk (mkCtx N S B W) sd.F n (TP D18.L sd (mkCtx N S B W) PT b g h r) (ckRecD sd n b g h r) = true)
    (hsum : ∀ r, r < 272 → D18.L.sumOkRD sd n r = true) (r : Fin 272) :
    (BsumD n S sd r).asTM.Valid
      (fun x => ∑ ι, (w0Part_of18 hg data s hA hord sd hden hnp PT hP n hpc).g ι r x) :=
  bsum_valid_gP D18.L 9 rfl
    (fun b hb => (nGrp_le D18.L b (Bridges.D18.link.checks b hb).grp).trans (by norm_num))
    hg sd _ data PT hP hnp n hn hpc r.val r.isLt (hsum r.val r.isLt)

#print axioms htag18
#print axioms w0Part_of18
#print axioms bsum_valid18

end ThomsonCompact.CoeffMap.Deg
