  by_cases h1 : j.val<16
  · exact segment_true (fun k => (inverseEquation 24 k).check) 8 8 inverse_checked_24_1 j (by omega) h1
  by_cases h2 : j.val<24
  · exact segment_true (fun k => (inverseEquation 24 k).check) 16 8 inverse_checked_24_2 j (by omega) h2
  by_cases h3 : j.val<32
  · exact segment_true (fun k => (inverseEquation 24 k).check) 24 8 inverse_checked_24_3 j (by omega) h3
  by_cases h4 : j.val<40
  · exact segment_true (fun k => (inverseEquation 24 k).check) 32 8 inverse_checked_24_4 j (by omega) h4
  by_cases h5 : j.val<48
  · exact segment_true (fun k => (inverseEquation 24 k).check) 40 8 inverse_checked_24_5 j (by omega) h5
  by_cases h6 : j.val<56
  · exact segment_true (fun k => (inverseEquation 24 k).check) 48 8 inverse_checked_24_6 j (by omega) h6
  by_cases h7 : j.val<64
  · exact segment_true (fun k => (inverseEquation 24 k).check) 56 8 inverse_checked_24_7 j (by omega) h7
  exact segment_true (fun k => (inverseEquation 24 k).check) 64 4 inverse_checked_24_8 j (by omega) (by omega)
