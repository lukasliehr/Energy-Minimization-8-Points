  (2/3:ℚ) • ∑e : ContactIndex,meanRadicalMul (varianceWeightData e.2)
    (meanRadicalMul (varianceProjectedLinearData (finProdFinEquiv e) i)
      (varianceProjectedMData (finProdFinEquiv e) j k)+
     meanRadicalMul (varianceProjectedLinearData (finProdFinEquiv e) j)
      (varianceProjectedMData (finProdFinEquiv e) i k)+
     meanRadicalMul (varianceProjectedLinearData (finProdFinEquiv e) k)
      (varianceProjectedMData (finProdFinEquiv e) i j))
end Blueprint.Thomson.Tail.Implementation
