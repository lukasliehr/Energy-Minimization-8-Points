import ThomsonCompact.CoeffMap.Deg.Bridges.D16.Link
import ThomsonCompact.Interface.D16

/-!
# The W0 part of `Residual16` from per-cell leaves (F2h; generated by `CoeffMap/Deg/gen/assemble.py`)

`W0Part16 s cell blk hord N nb` bundles exactly the fields `B`, `g`, `B_valid`, `W0_link` of
`Interface.D16.Residual16` (any `m`, `t`, `β`). For decoded cell data `data` (the exporter's
`Cells/<cell>/W0.lean`), literal cell `data.cell` and blocks `blkOf16 data` (`F0 … F7`, then
`M0_plus … Mdet_standard`), `w0Part_of16` builds it with `nb = 16 · 32 · 32` pieces `ι = 32 (32 b + g) + h` from
the per-cell leaf facts (see `CoeffMap.Deg.W0Part`); `bsum_valid16` gives the combined model per coordinate
(`Bsum_valid` of `API.md`).
-/

noncomputable section
open scoped BigOperators

namespace ThomsonCompact.CoeffMap.Deg

open Blueprint.CAP Blueprint.Thomson Blueprint.Thomson.Finite ThomsonCompact.CoeffMap ThomsonCompact.Packed
open ThomsonCompact.CoeffMap.Deg.Link

/-- The `Residual16` fields produced by F2 (W0 contributions and their link to the Gram map). -/
structure W0Part16 (s : ℝ → ℝ) (cell : Literals.Cell) (blk : GramBlock 8 → Literals.Block)
    (hord : ∀ b, (blk b).order = gramBlockDimension 8 b) (N nb : ℕ) where
  B : Fin nb → Fin 202 → QModel N
  g : Fin nb → Fin 202 → ℝ → ℝ
  B_valid : ∀ b r, (B b r).asTM.Valid (g b r)
  W0_link : ∀ (x : ℝ) (hx : x ∈ cellDomain) (hs : 0 ≤ s x) (r : Fin 202),
    retainCompatible (aS (s x)) 16 (ThomsonCompact.Interface.D16.gramMap s x hs
      (ThomsonCompact.Interface.D16.W0 cell blk hord x hx)) (ThomsonCompact.FixedD16.retainedIndex r) = ∑ b, g b r x

/-- Transport of a `W0Part16` along an equality of exponent functions. -/
def W0Part16.congr {s s' : ℝ → ℝ} {cell : Literals.Cell} {blk : GramBlock 8 → Literals.Block}
    {hord : ∀ b, (blk b).order = gramBlockDimension 8 b} {N nb : ℕ} (P : W0Part16 s cell blk hord N nb)
    (h : ∀ x, s x = s' x) : W0Part16 s' cell blk hord N nb :=
  (funext h : s = s') ▸ P

/-- Literal blocks of decoded cell data in the D16 Gram block order. -/
abbrev blkOf16 (data : CellData) : GramBlock 8 → Literals.Block := blkOfD 8 data

/-- `hord` from the decoded block orders (one `decide`). -/
theorem hord_of16 (data : CellData)
    (h : (((List.range 8).all fun k => Nat.beq (data.order k) (8 - k)) &&
      ((List.range 8).all fun j => Nat.beq (data.order (8 + j)) (D16.L.gdim (8 + j)))) = true) :
    ∀ b, (blkOf16 data b).order = gramBlockDimension 8 b := by
  rw [Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
  intro b
  cases b with
  | inl k => exact Nat.eq_of_beq_eq_true (h.1 k.val (List.mem_range.mpr k.isLt))
  | inr sb =>
    show data.order (8 + sIdx sb) = scalarBlockDimension sb 8
    rw [Nat.eq_of_beq_eq_true (h.2 (sIdx sb) (List.mem_range.mpr (sIdx_lt sb)))]
    exact Bridges.D16.facts.gdim_sc sb

/-- The retained tags of the fixed D16 table are the tags of the W0 data. -/
theorem htag16 : ∀ r : Fin 202, (ThomsonCompact.FixedD16.retainedIndex r).val = D16.L.rtag r.val := by
  have h : (List.range 202).all (fun r => teq (ThomsonCompact.Fixed.D16.decodeTag
      (ThomsonCompact.Fixed.D16.ltab.rtag r)) (D16.L.rtag r)) = true := by decide +kernel
  intro r
  rw [ThomsonCompact.FixedD16.retainedIndex_tag]
  rw [List.all_eq_true] at h
  exact teq_eq (h r.val (List.mem_range.mpr r.isLt))

/-- The W0 Gram family of the interface has the literal Gram entries of the data. -/
theorem W0_entry16 (data : CellData) (hord : ∀ b, (blkOf16 data b).order = gramBlockDimension 8 b) (x : ℝ)
    (hx : x ∈ cellDomain) (b : GramBlock 8) (i j : Fin (gramBlockDimension 8 b)) :
    (ThomsonCompact.Interface.D16.W0 data.cell (blkOf16 data) hord x hx).val b i j =
      litW data (bIdx 8 b) i.val j.val x := by
  have ho : data.order (bIdx 8 b) = gramBlockDimension 8 b := hord b
  have hi : i.val < data.order (bIdx 8 b) := by rw [ho]; exact i.isLt
  have hj : j.val < data.order (bIdx 8 b) := by rw [ho]; exact j.isLt
  unfold litW
  rw [dif_pos ⟨hi, hj⟩]
  rfl

variable {N S B W : ℕ}

/-- **The W0 part of `Residual16` from the leaves of a cell** (`nb = 16 · 32 · 32`). -/
noncomputable def w0Part_of16 (hg : Good N S B W) (data : CellData) (s : ℝ → ℝ) {A : TM}
    (hA : Encl (mkCtx N S B W) A (fun x => aS (s x)))
    (hord : ∀ b, (blkOf16 data b).order = gramBlockDimension 8 b) (sd : SumD)
    (hden : D16.L.denOkD (mkCtx N S B W) A sd = true) (hnp : ∀ b, b < 16 → sd.np b ≤ 32)
    (PT : ℕ → ℕ → ℕ → ℕ → TM)
    (hP : ∀ b h, b < D16.L.dH + 8 → h < sd.np b → ∀ u v,
      EnclOk (mkCtx N S B W) (PT b h u v) (fun t => PfL D16.L (fun x => aS (s x)) data b u v t))
    (n : ℕ) (hpc : ∀ b g h r, b < D16.L.dH + 8 → g < D16.L.nGrp b → h < sd.np b → r < D16.L.nc →
      (TP D16.L sd (mkCtx N S B W) PT b g h r).ok = true ∧
        ckOk (mkCtx N S B W) sd.F n (TP D16.L sd (mkCtx N S B W) PT b g h r) (ckRecD sd n b g h r) = true) :
    W0Part16 s data.cell (blkOf16 data) hord N (16 * 32 * 32) where
  B ι r := BP D16.L sd (mkCtx N S B W) PT ι r
  g ι r := gP D16.L sd (fun x => aS (s x)) data ι r
  B_valid ι r := BP_valid D16.L sd _ data hg PT hP n hpc ι r r.isLt
  W0_link x hx hs r :=
    gP_link D16.L 8 (by norm_num) (by norm_num) ThomsonCompact.Interface.D16.pivots
      ThomsonCompact.Interface.D16.pivots_valid Bridges.D16.link hg s hA sd hden hnp data x hx hs
      (ThomsonCompact.Interface.D16.W0 data.cell (blkOf16 data) hord x hx) (W0_entry16 data hord x hx)
      (ThomsonCompact.FixedD16.retainedIndex r) r.val r.isLt (htag16 r)

/-- **The final W0 sums enclose the sum of the pieces** (one combined model per coordinate). -/
theorem bsum_valid16 (hg : Good N S B W) (data : CellData) (s : ℝ → ℝ) {A : TM}
    (hA : Encl (mkCtx N S B W) A (fun x => aS (s x)))
    (hord : ∀ b, (blkOf16 data b).order = gramBlockDimension 8 b) (sd : SumD)
    (hden : D16.L.denOkD (mkCtx N S B W) A sd = true) (hnp : ∀ b, b < 16 → sd.np b ≤ 32)
    (PT : ℕ → ℕ → ℕ → ℕ → TM)
    (hP : ∀ b h, b < D16.L.dH + 8 → h < sd.np b → ∀ u v,
      EnclOk (mkCtx N S B W) (PT b h u v) (fun t => PfL D16.L (fun x => aS (s x)) data b u v t))
    (n : ℕ) (hn : n ≤ N) (hpc : ∀ b g h r, b < D16.L.dH + 8 → g < D16.L.nGrp b → h < sd.np b → r < D16.L.nc →
      (TP D16.L sd (mkCtx N S B W) PT b g h r).ok = true ∧
        ckOk (mkCtx N S B W) sd.F n (TP D16.L sd (mkCtx N S B W) PT b g h r) (ckRecD sd n b g h r) = true)
    (hsum : ∀ r, r < 202 → D16.L.sumOkRD sd n r = true) (r : Fin 202) :
    (BsumD n S sd r).asTM.Valid
      (fun x => ∑ ι, (w0Part_of16 hg data s hA hord sd hden hnp PT hP n hpc).g ι r x) :=
  bsum_valid_gP D16.L 8 rfl
    (fun b hb => (nGrp_le D16.L b (Bridges.D16.link.checks b hb).grp).trans (by norm_num))
    hg sd _ data PT hP hnp n hn hpc r.val r.isLt (hsum r.val r.isLt)

#print axioms htag16
#print axioms w0Part_of16
#print axioms bsum_valid16

end ThomsonCompact.CoeffMap.Deg
