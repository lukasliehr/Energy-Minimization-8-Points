theorem shift_row_16 (j : Fin 68) : shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 16 j) (shiftANumerator 16 j)=true := by
  have hj := j.isLt
  by_cases h0 : j.val<17
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 16 k) (shiftANumerator 16 k)) 0 17 shift_checked_16_0 j (by omega) h0
  by_cases h1 : j.val<50
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 16 k) (shiftANumerator 16 k)) 17 33 shift_checked_16_1 j (by omega) h1
  by_cases h2 : j.val<65
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 16 k) (shiftANumerator 16 k)) 50 15 shift_checked_16_2 j (by omega) h2
  exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 16 k) (shiftANumerator 16 k)) 65 3 shift_checked_16_3 j (by omega) (by omega)
theorem lift_row_16 (j : Fin 68) : (liftEquation 16 j).check=true := allBelow_spec _ _ lifts_checked_16 j j.isLt
theorem inverse_row_16 (j : Fin 68) : (inverseEquation 16 j).check=true := by
  have hj := j.isLt
  by_cases h0 : j.val<8
