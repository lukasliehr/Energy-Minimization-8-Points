theorem map_entry_accepted (r c : Fin 68) :
    (MapKernel.sourceEquation r.val c.val).check=true := by
  have hk : r.val/8<9 := by omega
  have hi : r.val%8 < min 8 (68-8*(r.val/8)) := by omega
  have hh := allBelow_spec _ _ (all_map_chunks c ⟨r.val/8,hk⟩) (r.val%8) hi
  have he : 8*(r.val/8)+r.val%8=r.val := by omega
  simpa only [he] using hh

theorem map_fullRow_agrees : ∀i : Fin 68,
    ThomsonNegative.Certificate.BasisLayout.fullRow i.val=(chartIndex i).val := by decide +kernel

theorem map_repairBlock (i : Fin 68) : MapKernel.repairBlock i.val=(repairBlock i).val := by
  rw [MapKernel.repairBlock,repairCoordinate_agrees]
theorem map_repairRow (i : Fin 68) : MapKernel.repairRow i.val=repairRow i := by
  rw [MapKernel.repairRow,repairCoordinate_agrees]
theorem map_repairCol (i : Fin 68) : MapKernel.repairCol i.val=repairCol i := by
  rw [MapKernel.repairCol,repairCoordinate_agrees]
theorem map_multiplicity (i : Fin 68) : (MapKernel.multiplicity i.val:ℝ)=repairMultiplicity i := by
  simp only [MapKernel.multiplicity,map_repairRow,map_repairCol,repairMultiplicity]
  by_cases h : repairRow i=repairCol i <;> simp [h]

theorem map_weight_value (r c : Fin 68) (k : Nat) :
    (sv (MapKernel.weight r.val c.val k):ℝ)=repairMultiplicity c*
      (RawData.coefficient (repairBlock c).val (chartIndex r).val
        (k/rawSize (repairBlock c)) (k%rawSize (repairBlock c)):ℝ) := by
  simp only [MapKernel.weight,map_repairBlock,raw_size_agrees,sv_sm,nat_mul,
    Int.cast_sub,Int.cast_natCast,Nat.cast_mul,map_fullRow_agrees,RawData.coefficient]
  push_cast
  change (MapKernel.multiplicity c.val:ℝ)*_-(MapKernel.multiplicity c.val:ℝ)*_=_
  rw [map_multiplicity]
  ring

theorem square_sum (n : Nat) (f : Nat → Nat → ℝ) :
    (∑ k∈Finset.range (n*n),f (k/n) (k%n))=∑ r : Fin n,∑ s : Fin n,f r.val s.val := by
  rw [← Fin.sum_univ_eq_sum_range]
  have hh := Equiv.sum_comp (finProdFinEquiv.symm : Fin (n*n) ≃ Fin n × Fin n)
    (fun p => f p.1.val p.2.val)
  simpa only [Fintype.sum_prod_type,finProdFinEquiv_symm_apply,Fin.divNat,Fin.modNat] using hh

theorem map_square_accepted (b : Block) : (MapSquare.equation b.val).check=true := by
  fin_cases b
  · exact MapSquare.block0
  · exact MapSquare.block1
  · exact MapSquare.block2
  · exact MapSquare.block3
  · exact MapSquare.block4
  · exact MapSquare.block5
  · exact MapSquare.block6
  · exact MapSquare.block7
theorem map_rawDen_decode : ∀b : Block,
    recCoeffs (MapSquare.rawDen b.val)=[Int.ofNat (RawData.denominator b.val)] := by decide +kernel

theorem map_square_eval (a : ℝ) (b : Block) :
    evalZ (recCoeffs (MapKernel.basisSquare b.val)) a=
      basisDenominator a b*basisDenominator a b*(RawData.denominator b.val:ℝ) := by
  have h := (MapSquare.equation b.val).sound (map_square_accepted b) a
  simpa [MapSquare.equation,oneRecord_decode,map_rawDen_decode,evalZ,horner,basisDenominator] using h.symm

theorem source_map_polynomial_identity (a : ℝ) (r c : Fin 68) :
    (∑ i : Fin (rawSize (repairBlock c)),∑ j : Fin (rawSize (repairBlock c)),
      repairMultiplicity c*(RawData.coefficient (repairBlock c).val (chartIndex r).val i.val j.val:ℝ)*
        (clearedBasis a (repairBlock c) i (repairRowFin c)*
          clearedBasis a (repairBlock c) j (repairColFin c)))*
      evalZ (recCoeffs Factored.HighData.A.denominator) a=
    evalZ (recCoeffs (Factored.HighData.A.numerator r.val c.val)) a*
      (basisDenominator a (repairBlock c)*basisDenominator a (repairBlock c)*
        (RawData.denominator (repairBlock c).val:ℝ)) := by
  have h := (MapKernel.sourceEquation r.val c.val).sound (map_entry_accepted r c) a
  simp only [MapKernel.sourceEquation,map_repairBlock,map_repairRow,map_repairCol,
    raw_size_agrees,nat_mul,oneRecord_decode,evalZ,horner,List.map_cons,List.map_nil,
    Int.cast_one,mul_zero,add_zero,mul_one] at h
  change (∑ k∈Finset.range (rawSize (repairBlock c)*rawSize (repairBlock c)),
    (sv (MapKernel.weight r.val c.val k):ℝ)*
      (evalZ (recCoeffs (BasisData.numerator (repairBlock c).val
        (k/rawSize (repairBlock c)) (repairRow c))) a*
       evalZ (recCoeffs (BasisData.numerator (repairBlock c).val
        (k%rawSize (repairBlock c)) (repairCol c))) a))*
      evalZ (recCoeffs Factored.HighData.A.denominator) a=
    evalZ (recCoeffs (Factored.HighData.A.numerator r.val c.val)) a*
      evalZ (recCoeffs (MapKernel.basisSquare (repairBlock c).val)) a at h
  simp_rw [map_weight_value] at h
  rw [square_sum (rawSize (repairBlock c)) (fun i j =>
    repairMultiplicity c*(RawData.coefficient (repairBlock c).val (chartIndex r).val i j:ℝ)*
      (evalZ (recCoeffs (BasisData.numerator (repairBlock c).val i (repairRow c))) a*
       evalZ (recCoeffs (BasisData.numerator (repairBlock c).val j (repairCol c))) a)),
    map_square_eval] at h
  exact h

