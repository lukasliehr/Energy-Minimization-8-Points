import ThomsonCompact.Fixed.SoundSem
import ThomsonCompact.Fixed.D12c.Slice0
import ThomsonCompact.Fixed.D12c.Slice1
import ThomsonCompact.Fixed.D12c.Slice2
import ThomsonCompact.Fixed.D12c.Slice3
import ThomsonCompact.Fixed.D12c.Slice4
import ThomsonCompact.Fixed.D12c.Slice5
import ThomsonCompact.Fixed.D12c.Slice6
import ThomsonCompact.Fixed.D12c.Slice7
import ThomsonCompact.Fixed.D12c.LeafOnce
import ThomsonCompact.Fixed.D12c.LeafL0

/-!
# D12: the polynomial identities from the kernel leaves (generated by `tools/f4_export.py`)

Instantiates the generic soundness theorems with the D12 data: (T) `table`, (G) `gid`, the factorization `qfac` of
`Q`, `Δc = S S rden` (`dc`), the denominator cofactors (`dens`) and the RF/κ identities (`rf`). No old-project imports.
-/

namespace ThomsonCompact.Fixed.D12c

open ThomsonCompact.Fixed ThomsonCompact.Packed

/-- The leaf slices. -/
noncomputable def slices : List Slice :=
  [slice0, slice1, slice2, slice3, slice4, slice5, slice6, slice7]

theorem tab_R : tab.R = 448 := rfl
theorem tab_n : tab.n = 100 := rfl

theorem rtag_spec : (∀ i, i < 100 → notRetained ltab.D (ltab.rtag i) = false) ∧
    ∀ i j, i < 100 → j < 100 → ltab.rtag i = ltab.rtag j → i = j := rtagOk_spec ltab 100 rtag_ok

theorem links : ∀ k, k < tab.n → colLinkOk tab ltab k = true := by
  intro k hk
  rw [tab_n] at hk
  exact linkOk_spec tab ltab 100 0 link0 k (by omega) (by omega)

theorem leaves : ∀ S ∈ slices, leafOk tab S = true ∧ S.LH ≤ 61 ∧ S.wH ≤ 150 := by
  intro S hS
  simp only [slices, List.mem_cons, List.not_mem_nil, or_false] at hS
  rcases hS with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨leaf0, le_refl _, le_refl _⟩
  · exact ⟨leaf1, le_refl _, le_refl _⟩
  · exact ⟨leaf2, le_refl _, le_refl _⟩
  · exact ⟨leaf3, le_refl _, le_refl _⟩
  · exact ⟨leaf4, le_refl _, le_refl _⟩
  · exact ⟨leaf5, le_refl _, le_refl _⟩
  · exact ⟨leaf6, le_refl _, le_refl _⟩
  · exact ⟨leaf7, le_refl _, le_refl _⟩

theorem cover_check :
    (List.range 100).all (fun i => slices.any fun S => decide (S.i0 ≤ i ∧ i < S.i0 + S.len)) = true := by
  decide +kernel

theorem cover : ∀ i, i < tab.n → ∃ S ∈ slices, S.i0 ≤ i ∧ i < S.i0 + S.len := by
  intro i hi
  have h := List.all_eq_true.mp cover_check i (List.mem_range.mpr hi)
  obtain ⟨S, hS, h2⟩ := List.any_eq_true.mp h
  exact ⟨S, hS, of_decide_eq_true h2⟩

theorem bound : 2 * (tab.n * (64 * (64 * (255 * (255 * 65535) * (recBound 13 23 * recBound 13 23)))) *
    (recBound gtab.LG gtab.wG * recBound 61 150) + gtab.s * recBound gtab.LQ gtab.wQ) < 2 ^ tab.R := by
  decide +kernel

/-- **(T) for D12**, all real `t`. -/
theorem table : ∀ i i', i < 100 → i' < 100 → ∀ t : ℝ,
    ∑ k ∈ Finset.range 100, evalZ (nC ltab k i) t * (evalZ (gamC gtab k) t * evalZ (hC slices k i') t) =
      if i = i' then (gtab.s : ℝ) * evalZ (qC gtab) t else 0 :=
  table_poly tab gtab ltab slices 61 150 13 23 64 (by rw [tab_R]; norm_num) tab_ok leaves cover g_ok links
    kap_ok rtag_spec.2 rtag_spec.1 bound

/-- **(G) for D12**, all real `t`. -/
theorem gid : ∀ k, k < 100 → 1 ≤ dqG gtab k ∧ ∀ t : ℝ,
    ((lamG gtab k * dcG gtab k : ℕ) : ℝ) * evalZ (gamC gtab k) t * evalZ (dzC gtab k) t * evalZ (blC gtab k) t ^ 2 =
      ((gtab.s * dqG gtab k : ℕ) : ℝ) * evalZ (qC gtab) t :=
  (gLinkOk_sound tab gtab (by rw [tab_R]; norm_num) g_ok).2.2.2.2

/-- The factorization of `Q`. -/
theorem qfac (t : ℝ) : evalZ (qC gtab) t = (if stab.fsgn then -1 else 1) * evalZ (prodF stab stab.nfac) t :=
  facOk_sound tab gtab stab (by rw [tab_R]; norm_num) g_ok fac_ok t

theorem dc_parts : dcOk gtab ltab stab 100 = true ∧ denOk 448 gtab stab = true := by
  have := dc_ok
  rw [Bool.and_eq_true] at this
  exact this

/-- `Δc_k = S_(b,r) S_(b,c) rden_b`. -/
theorem dc : ∀ k, k < 100 → dcG gtab k =
    stab.sc (oBlk ltab k) (oRow ltab k) * stab.sc (oBlk ltab k) (oCol ltab k) * stab.rd (oBlk ltab k) :=
  dcOk_spec gtab ltab stab 100 dc_parts.1

/-- The denominator cofactors. -/
theorem dens : ∀ d, d < stab.nden → 1 ≤ stab.rdsc d ∧ rhoZ stab d ≠ 0 ∧
    CoefB stab.LD stab.wD (recCoeffs (stab.rden d)) ∧ ∀ t : ℝ,
      evalZ (recCoeffs (stab.rden d)) t * evalZ (recCoeffs (stab.rcof d)) t =
        (rhoZ stab d : ℝ) * evalZ (blkC gtab (stab.rblk d)) t :=
  denOk_sound tab gtab stab (by rw [tab_R]; norm_num) g_ok dc_parts.2

/-- The scalar κ entries against their RF records (blocks 2 = m0Plus, 3 = m0Standard). -/
theorem rf (b : Nat) (hb : b = 2 ∨ b = 3) : ∀ j u, j < stab.ncol b → u < stab.nraw b →
    1 ≤ stab.rsc (stab.col b j u) ∧ 1 ≤ stab.sc b j ∧ stab.rdi (stab.col b j u) < stab.nden ∧ ∀ t : ℝ,
      evalZ (recCoeffs (stab.rnum (stab.col b j u))) t * ((stab.rdsc (stab.rdi (stab.col b j u)) * stab.sc b j : ℕ) : ℝ) *
          evalZ (blkC gtab b) t =
        evalZ (kapE ltab b j u) t * (stab.rsc (stab.col b j u) : ℝ) *
          evalZ (recCoeffs (stab.rden (stab.rdi (stab.col b j u)))) t := by
  intro j u hj hu
  have hok : rfOk tab.R gtab ltab stab 13 23 b = true := by rcases hb with rfl | rfl; exact rf2_ok; exact rf3_ok
  have hK : 1 ≤ polyVecOk 13 23 64 (ltab.kc b j) (ltab.kn b j) 0 1 :=
    (kapHdrOk_spec ltab 100 13 23 64 kap_ok).1 b j (by omega) (by
      have : stab.ncol b ≤ 20 := by rcases hb with rfl | rfl <;> decide
      omega)
  exact rfEnt_sound tab gtab ltab stab 13 23 64 b j u (by rw [tab_R]; norm_num) g_ok hK
    (fun d hd => (dens d hd).2.2.1) (rfOk_spec _ _ _ _ _ _ _ hok j u hj hu)

#print axioms table
#print axioms gid
#print axioms qfac
#print axioms rf

end ThomsonCompact.Fixed.D12c
