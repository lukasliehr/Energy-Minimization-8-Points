theorem functional_denominator_pos : ∀i : Fin 102,0<Factored.FunctionalData.denominator i.val := by decide +kernel
theorem functional_scale_product : ∀i : Fin 102,
    (4/Factored.FunctionalData.denominator i.val)*Factored.FunctionalData.denominator i.val=4 := by decide +kernel
theorem raw_denominator_pos : ∀b : Block,0<RawData.denominator b.val := by decide +kernel
theorem null_denominator_decode : ∀b : Block,
    recCoeffs (NullData.denominator b.val)=[Int.ofNat (4*RawData.denominator b.val)] := by decide +kernel
theorem null_numerator_symm : ∀(b : Block)(r s : Fin (rawSize b)),
    NullData.numerator b.val r.val s.val=NullData.numerator b.val s.val r.val := by decide +kernel

theorem functional_scale (i : Fin 102) :
    ((4/Factored.FunctionalData.denominator i.val:Nat):ℝ)=
      4/(Factored.FunctionalData.denominator i.val:ℝ) := by
  have h := congrArg (Nat.cast : ℕ → ℝ) (functional_scale_product i)
  have hn : (Factored.FunctionalData.denominator i.val:ℝ)≠0 := by
    exact_mod_cast ne_of_gt (functional_denominator_pos i)
  apply (eq_div_iff hn).mpr
  simpa using h

theorem null_weight_value (b : Block) (r s : Fin (rawSize b)) (i : Fin 102) :
    (sv (NullKernel.rowWeight b.val r.val s.val i.val):ℝ)=
      (RawData.coefficient b.val i.val r.val s.val:ℝ)*
        (4/(Factored.FunctionalData.denominator i.val:ℝ)) := by
  simp only [NullKernel.rowWeight,sv_sm,nat_mul,Int.cast_sub,Int.cast_natCast,Nat.cast_mul,
    RawData.coefficient]
  push_cast
  change (RawData.positiveSlot b.val i.val r.val s.val:ℝ)*
    ((4/Factored.FunctionalData.denominator i.val:Nat):ℝ)-
    (RawData.negativeSlot b.val i.val r.val s.val:ℝ)*
    ((4/Factored.FunctionalData.denominator i.val:Nat):ℝ)=_
  rw [functional_scale]
  ring

def rawValueMatrix (a : ℝ) (b : Block) : Matrix (Fin (rawSize b)) (Fin (rawSize b)) ℝ :=
  fun r s => coefficientEll0 a (rawCoefficientVector b r s)

def rawSlopeMatrix (a : ℝ) (b : Block) : Matrix (Fin (rawSize b)) (Fin (rawSize b)) ℝ :=
  fun r s => coefficientEll1 a (rawCoefficientVector b r s)

theorem rawValueMatrix_entry (a : ℝ) (b : Block) (r s : Fin (rawSize b)) :
    rawValueMatrix a b r s=
      evalZ (recCoeffs (NullData.numerator b.val r.val s.val)) a/
        evalZ (recCoeffs (NullData.denominator b.val)) a := by
  have hs : s.val<RawData.size b.val := by rw [raw_size_agrees];exact s.isLt
  have hc := allBelow_spec _ _ (null_source_row_accepted b r) s.val hs
  have he := (NullKernel.sourceEquation b.val r.val s.val).sound hc a
  change (∑ i∈Finset.range 102,(sv (NullKernel.rowWeight b.val r.val s.val i):ℝ)*
      (evalZ (recCoeffs (Factored.FunctionalData.numerator i)) a*evalZ (recCoeffs oneRecord) a))*
      evalZ (recCoeffs oneRecord) a=
    evalZ (recCoeffs (NullData.numerator b.val r.val s.val)) a*
      evalZ (recCoeffs oneRecord) a*evalZ (recCoeffs oneRecord) a at he
  simp only [oneRecord_decode,evalZ,horner,List.map_cons,List.map_nil,Int.cast_one,
    mul_zero,add_zero,mul_one] at he
  change (∑ i∈Finset.range 102,(sv (NullKernel.rowWeight b.val r.val s.val i):ℝ)*
    evalZ (recCoeffs (Factored.FunctionalData.numerator i)) a)=
      evalZ (recCoeffs (NullData.numerator b.val r.val s.val)) a at he
  rw [← Fin.sum_univ_eq_sum_range] at he
  simp_rw [null_weight_value] at he
  have hd : (RawData.denominator b.val:ℝ)≠0 := by exact_mod_cast ne_of_gt (raw_denominator_pos b)
  rw [rawValueMatrix,coefficientEll0_rows]
  simp only [rawCoefficientVector,rawCoefficient]
  have hterm (i : Fin 102) :
      ((RawData.coefficient b.val i.val r.val s.val:ℝ)/RawData.denominator b.val)*
      (evalZ (recCoeffs (Factored.FunctionalData.numerator i.val)) a/
        Factored.FunctionalData.denominator i.val)=
      ((RawData.coefficient b.val i.val r.val s.val:ℝ)*(4/Factored.FunctionalData.denominator i.val)*
        evalZ (recCoeffs (Factored.FunctionalData.numerator i.val)) a)/(4*RawData.denominator b.val) := by
    have hi : (Factored.FunctionalData.denominator i.val:ℝ)≠0 := by
      exact_mod_cast ne_of_gt (functional_denominator_pos i)
    field_simp
    <;> ring
  simp_rw [hterm]
  rw [← Finset.sum_div,he,null_denominator_decode]
  simp [evalZ,horner]

theorem rawValueMatrix_symm (a : ℝ) (b : Block) : (rawValueMatrix a b).IsSymm := by
  ext r s
  simp only [Matrix.transpose_apply,rawValueMatrix_entry,null_numerator_symm b s r]

theorem null_T_eval (a : ℝ) (b : Nat) :
    (NullData.T b).eval a=(fun r s =>
      evalZ (recCoeffs (NullData.numerator b r.val s.val)) a/
        evalZ (recCoeffs (NullData.denominator b)) a) := rfl

theorem null_U_eval (a : ℝ) (b : Nat) :
    (NullData.U b).eval a=(fun r j =>
      evalZ (recCoeffs (BasisData.numerator b r.val j.val)) a) := by
  ext r j
  simp [EncodedMatrix.eval,NullData.U,oneRecord_decode,evalZ,horner]

theorem rawValueMatrix_null (a : ℝ) (b : Block) :
    rawValueMatrix a b*clearedBasis a b=0 := by
  have hT (b : Block) : (NullData.T b.val).RegularAt a := by
    change evalZ (recCoeffs (NullData.denominator b.val)) a≠0
    rw [null_denominator_decode]
    have hz : ((4*RawData.denominator b.val:Nat):ℝ)≠0 := by
      exact_mod_cast Nat.mul_ne_zero (by decide : (4:Nat)≠0) (ne_of_gt (raw_denominator_pos b))
    simpa [evalZ,horner] using hz
  have hU (b : Block) : (NullData.U b.val).RegularAt a := by
    simp [EncodedMatrix.RegularAt,NullData.U,oneRecord_decode,evalZ,horner]
  have hn : ∀b : Block,ThomsonNegative.Certificate.BasisLayout.freeOrder b.val=blockSize b := by decide +kernel
  have hf : ∀ (b : Block) (j : Fin (ThomsonNegative.Certificate.BasisLayout.freeOrder b.val)),
      NullKernel.nullColumnCheck b.val j.val=true := by
    intro b j
    exact null_column_accepted b ⟨j.val,by rw [← hn b];exact j.isLt⟩
  have hm (b : Block) := product_matrix_sound (NullData.T b.val) (NullData.U b.val)
    (EncodedMatrix.zero (RawData.size b.val) (ThomsonNegative.Certificate.BasisLayout.freeOrder b.val)) 123 13 31 a
    (hT b) (hU b) (EncodedMatrix.zero_regular _ _ a) (hf b)
  have entry (r s : Fin (rawSize b)) := rawValueMatrix_entry a b r s
  have hmatrix : rawValueMatrix a b=
      (fun r s => evalZ (recCoeffs (NullData.numerator b.val r.val s.val)) a/
        evalZ (recCoeffs (NullData.denominator b.val)) a) := by
    ext r s
    exact rawValueMatrix_entry a b r s
  rw [hmatrix]
  unfold clearedBasis
  have hh := hm b
  simp only [null_T_eval,null_U_eval,EncodedMatrix.eval_zero] at hh
  rw [raw_size_agrees b,hn b] at hh
  exact hh

theorem rawSlopeMatrix_sandwich (a : ℝ) (b : Block) :
    (clearedBasis a b).transpose*rawSlopeMatrix a b*clearedBasis a b=0 :=
  differentiable_matrix_nullspace_derivative (fun t => rawValueMatrix t b)
    (fun t => clearedBasis t b) (rawSlopeMatrix a b) a (rawValueMatrix_symm a b)
    (fun r s => coefficientEll_hasDerivAt _ a)
    (fun r j => clearedBasis_differentiableAt b r j a)
    (fun t => rawValueMatrix_null t b)

#print axioms rawValueMatrix_null
#print axioms rawSlopeMatrix_sandwich
