import ThomsonCompact.CoeffMap.RFCore
import ThomsonCompact.Fixed.Sound
import ThomsonCompact.Fixed.D12c.STable
import AllS.Units.N_FI.N_kernels.N_named_features

/-! D12 RF records (`RFRec`, F2 shape) decoded from the packed semantic data `stab` and the raw scalar tags
(generated by `tools/f4_export.py`). -/

namespace ThomsonCompact.Fixed.D12c

open ThomsonCompact.Fixed ThomsonCompact.CoeffMap Blueprint.Thomson.Finite

/-- Number of RF records. -/
def nRec : Nat := 232

/-- RF record `k`: `(num / scN) / (den / scD)` with the dense catalogue coefficient lists. -/
noncomputable def rfrec (k : Nat) : RFRec :=
  ⟨recCoeffs (stab.rnum k), stab.rsc k, recCoeffs (stab.rden (stab.rdi k)), stab.rdsc (stab.rdi k)⟩

/-- Tag of a code `x + 32 y + 1024 z`. -/
def decodeTag (c : Nat) : Tag := (Nat.land c 31, Nat.land (Nat.shiftRight c 5) 31, Nat.shiftRight c 10)

/-- Raw scalar tag `u` of block `b` (2 = m0Plus, 3 = m0Standard): standard flag (bit 15) and tag. -/
noncomputable def rawTag (b u : Nat) : StandardTag :=
  (Nat.beq (Nat.shiftRight (ltab.rt b u) 15) 1, decodeTag (Nat.land (ltab.rt b u) 32767))

end ThomsonCompact.Fixed.D12c
