/-!
# D18: the polynomial identities from the kernel leaves (generated by `tools/f4_export.py`)

Instantiates the generic soundness theorems with the D18 data: (T) `table`, (G) `gid`, the factorization `qfac` of
`Q`, `Δc = S S rden` (`dc`), the denominator cofactors (`dens`) and the RF/κ identities (`rf`). No old-project imports.
-/

namespace ThomsonCompact.Fixed.D18c

open ThomsonCompact.Fixed ThomsonCompact.Packed

/-- The leaf slices. -/
noncomputable def slices : List Slice :=
  [slice0, slice1, slice2, slice3, slice4, slice5, slice6, slice7, slice8, slice9, slice10, slice11, slice12, slice13, slice14, slice15, slice16, slice17, slice18, slice19]

theorem tab_R : tab.R = 448 := rfl
theorem tab_n : tab.n = 272 := rfl

theorem rtag_spec : (∀ i, i < 272 → notRetained ltab.D (ltab.rtag i) = false) ∧
    ∀ i j, i < 272 → j < 272 → ltab.rtag i = ltab.rtag j → i = j := rtagOk_spec ltab 272 rtag_ok

theorem links : ∀ k, k < tab.n → colLinkOk tab ltab k = true := by
  intro k hk
  rw [tab_n] at hk
  by_cases h0 : k < 91
  · exact linkOk_spec tab ltab 91 0 link0 k (by omega) (by omega)
  by_cases h1 : k < 182
  · exact linkOk_spec tab ltab 91 91 link1 k (by omega) (by omega)
  exact linkOk_spec tab ltab 90 182 link2 k (by omega) (by omega)

theorem leaves : ∀ S ∈ slices, leafOk tab S = true ∧ S.LH ≤ 70 ∧ S.wH ≤ 174 := by
  intro S hS
  simp only [slices, List.mem_cons, List.not_mem_nil, or_false] at hS
  rcases hS with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨leaf0, le_refl _, le_refl _⟩
  · exact ⟨leaf1, le_refl _, le_refl _⟩
  · exact ⟨leaf2, le_refl _, le_refl _⟩
  · exact ⟨leaf3, le_refl _, le_refl _⟩
  · exact ⟨leaf4, le_refl _, le_refl _⟩
  · exact ⟨leaf5, le_refl _, le_refl _⟩
  · exact ⟨leaf6, le_refl _, le_refl _⟩
  · exact ⟨leaf7, le_refl _, le_refl _⟩
  · exact ⟨leaf8, le_refl _, le_refl _⟩
  · exact ⟨leaf9, le_refl _, le_refl _⟩
  · exact ⟨leaf10, le_refl _, le_refl _⟩
  · exact ⟨leaf11, le_refl _, le_refl _⟩
  · exact ⟨leaf12, le_refl _, le_refl _⟩
  · exact ⟨leaf13, le_refl _, le_refl _⟩
  · exact ⟨leaf14, le_refl _, le_refl _⟩
  · exact ⟨leaf15, le_refl _, le_refl _⟩
  · exact ⟨leaf16, le_refl _, le_refl _⟩
  · exact ⟨leaf17, le_refl _, le_refl _⟩
  · exact ⟨leaf18, le_refl _, le_refl _⟩
  · exact ⟨leaf19, le_refl _, le_refl _⟩

theorem cover_check :
    (List.range 272).all (fun i => slices.any fun S => decide (S.i0 ≤ i ∧ i < S.i0 + S.len)) = true := by
  decide +kernel

theorem cover : ∀ i, i < tab.n → ∃ S ∈ slices, S.i0 ≤ i ∧ i < S.i0 + S.len := by
  intro i hi
  have h := List.all_eq_true.mp cover_check i (List.mem_range.mpr hi)
  obtain ⟨S, hS, h2⟩ := List.any_eq_true.mp h
  exact ⟨S, hS, of_decide_eq_true h2⟩

theorem bound : 2 * (tab.n * (128 * (128 * (255 * (255 * 65535) * (recBound 16 26 * recBound 16 26)))) *
    (recBound gtab.LG gtab.wG * recBound 70 174) + gtab.s * recBound gtab.LQ gtab.wQ) < 2 ^ tab.R := by
  decide +kernel

/-- **(T) for D18**, all real `t`. -/
theorem table : ∀ i i', i < 272 → i' < 272 → ∀ t : ℝ,
    ∑ k ∈ Finset.range 272, evalZ (nC ltab k i) t * (evalZ (gamC gtab k) t * evalZ (hC slices k i') t) =
      if i = i' then (gtab.s : ℝ) * evalZ (qC gtab) t else 0 :=
  table_poly tab gtab ltab slices 70 174 16 26 128 (by rw [tab_R]; norm_num) tab_ok leaves cover g_ok links
    kap_ok rtag_spec.2 rtag_spec.1 bound

/-- **(G) for D18**, all real `t`. -/
theorem gid : ∀ k, k < 272 → 1 ≤ dqG gtab k ∧ ∀ t : ℝ,
    ((lamG gtab k * dcG gtab k : ℕ) : ℝ) * evalZ (gamC gtab k) t * evalZ (dzC gtab k) t * evalZ (blC gtab k) t ^ 2 =
      ((gtab.s * dqG gtab k : ℕ) : ℝ) * evalZ (qC gtab) t :=
  (gLinkOk_sound tab gtab (by rw [tab_R]; norm_num) g_ok).2.2.2.2

/-- The factorization of `Q`. -/
theorem qfac (t : ℝ) : evalZ (qC gtab) t = (if stab.fsgn then -1 else 1) * evalZ (prodF stab stab.nfac) t :=
  facOk_sound tab gtab stab (by rw [tab_R]; norm_num) g_ok fac_ok t

theorem dc_parts : dcOk gtab ltab stab 272 = true ∧ denOk 448 gtab stab = true := by
  have := dc_ok
  rw [Bool.and_eq_true] at this
  exact this

/-- `Δc_k = S_(b,r) S_(b,c) rden_b`. -/
theorem dc : ∀ k, k < 272 → dcG gtab k =
    stab.sc (oBlk ltab k) (oRow ltab k) * stab.sc (oBlk ltab k) (oCol ltab k) * stab.rd (oBlk ltab k) :=
  dcOk_spec gtab ltab stab 272 dc_parts.1

/-- The denominator cofactors. -/
theorem dens : ∀ d, d < stab.nden → 1 ≤ stab.rdsc d ∧ rhoZ stab d ≠ 0 ∧
    CoefB stab.LD stab.wD (recCoeffs (stab.rden d)) ∧ ∀ t : ℝ,
      evalZ (recCoeffs (stab.rden d)) t * evalZ (recCoeffs (stab.rcof d)) t =
        (rhoZ stab d : ℝ) * evalZ (blkC gtab (stab.rblk d)) t :=
  denOk_sound tab gtab stab (by rw [tab_R]; norm_num) g_ok dc_parts.2

/-- The scalar κ entries against their RF records (blocks 2 = m0Plus, 3 = m0Standard). -/
theorem rf (b : Nat) (hb : b = 2 ∨ b = 3) : ∀ j u, j < stab.ncol b → u < stab.nraw b →
    1 ≤ stab.rsc (stab.col b j u) ∧ 1 ≤ stab.sc b j ∧ stab.rdi (stab.col b j u) < stab.nden ∧ ∀ t : ℝ,
      evalZ (recCoeffs (stab.rnum (stab.col b j u))) t * ((stab.rdsc (stab.rdi (stab.col b j u)) * stab.sc b j : ℕ) : ℝ) *
          evalZ (blkC gtab b) t =
        evalZ (kapE ltab b j u) t * (stab.rsc (stab.col b j u) : ℝ) *
          evalZ (recCoeffs (stab.rden (stab.rdi (stab.col b j u)))) t := by
  intro j u hj hu
  have hok : rfOk tab.R gtab ltab stab 16 26 b = true := by rcases hb with rfl | rfl; exact rf2_ok; exact rf3_ok
  have hK : 1 ≤ polyVecOk 16 26 128 (ltab.kc b j) (ltab.kn b j) 0 1 :=
    (kapHdrOk_spec ltab 272 16 26 128 kap_ok).1 b j (by omega) (by
      have : stab.ncol b ≤ 65 := by rcases hb with rfl | rfl <;> decide
      omega)
  exact rfEnt_sound tab gtab ltab stab 16 26 128 b j u (by rw [tab_R]; norm_num) g_ok hK
    (fun d hd => (dens d hd).2.2.1) (rfOk_spec _ _ _ _ _ _ _ hok j u hj hu)

