import ThomsonCompact.CoeffMap.Deg.Poly
import ThomsonCompact.CoeffMap.RFCodec
import ThomsonCompact.CoeffMap.ListUtil

/-!
# Per-degree W0 data: layout and decoding (Init only; F2e)

One record `DegD` per degree (`D14`, `D16`, `D18`; generated by `CoeffMap/Deg/gen/degdata.py`) holds every per-degree
table of the W0 block contributions. Blocks are numbered in the `blockEquiv` order: moment blocks `F0 … F_{d-1}`
(`b < dH`), then the eight scalar blocks `M0_plus … Mdet_standard` (`b = dH + j`).

* coordinates: retained tag codes `rtag r` (16-bit slots), inverse table `ridx` (16-bit slots indexed by the tag code
  `code t = t.1 + 2^aA (t.2.1 + 2^aB t.2.2)`, value `nc` when `t` is not retained);
* scalar rows: packed RF records (`rfW`-bit biased slots, numerator records of `rfR` slots, denominator records of
  `rfRD` slots) and column tables `colRec j i u` (16-bit slots, column-major);
* classes (`CoeffMap.Deg.Prog`): the coefficient pairs `u ≤ v` of block `b` are partitioned into classes `k` with
  the same raw-tensor polynomial; `clsPairs b k` lists them (16-bit slots `u | v << 8`); `clsKey b k` is the
  polynomial key (scalar blocks: `tag code | lq << 16 | rq << 17` of the raw scalar spec; moment blocks: the pair);
* moment raw tensors: per moment block `b` and pair key, the sparse list of the old `RawMomentTensors.D<2d>_Fb.source`
  (64-bit slots: tag code, signed value `2|x| + [x<0]` in bits 16…);
* coefficient lists `eL b g r` (32-bit slots `k | neg << 12 | m << 13`): the nonzero raw-tensor coefficients
  `(class, ±m / den)` of coordinate `r` over the classes of group `g` of block `b` (classes `glo b g ≤ k < glo b (g+1)`).
-/

namespace ThomsonCompact.CoeffMap.Deg

/-- Slot `i` of a stream of `w`-bit slots, `2^p` slots per numeral. -/
def sAt (ch : Nat → Nat) (w p i : Nat) : Nat :=
  slotAt w (ch (Nat.shiftRight i p)) (Nat.land i (Nat.sub (Nat.shiftLeft 1 p) 1))

/-- `n` consecutive slots of a stream from index `i`. -/
def sRun (ch : Nat → Nat) (w p : Nat) : Nat → Nat → List Nat :=
  fun n => Nat.rec (motive := fun _ => Nat → List Nat) (fun _ => [])
    (fun _ ih i => sAt ch w p i :: ih (Nat.add i 1)) n

/-- `k` slots of width `w` peeled from `x` (low first). -/
def peel (w : Nat) (k : Nat) : Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat) (fun _ => [])
    (fun _ ih x => Nat.land x (Nat.sub (Nat.shiftLeft 1 w) 1) :: ih (Nat.shiftRight x w)) k

/-- Tag of a code (`aA`, `aB` bit fields). -/
def decT (aA aB c : Nat) : T3 :=
  (Nat.land c (Nat.sub (Nat.shiftLeft 1 aA) 1),
    Nat.land (Nat.shiftRight c aA) (Nat.sub (Nat.shiftLeft 1 aB) 1), Nat.shiftRight c (Nat.add aA aB))

/-- Code of a tag. -/
def encT (aA aB : Nat) (t : T3) : Nat := Nat.add t.1 (Nat.shiftLeft (Nat.add t.2.1 (Nat.shiftLeft t.2.2 aB)) aA)

/-- Family and determinant flag of scalar block `j` (`rawScalarProductSpec` order m0Plus … mdetStandard). -/
def famOf (j : Nat) : Nat := cond (Nat.ble 5 j) (Nat.sub j 5) j
def detOf (j : Nat) : Bool := Nat.ble 5 j

/-- Biased `w`-bit slot as an integer. -/
def unbiasW (w v : Nat) : Int := Int.subNatNat v (Nat.shiftLeft 1 (Nat.sub w 1))

/-- `(v < bias, |v - bias|, M)`: `unbiasW w v / M` as a `hornerQ` triple (`Nat` operations only). -/
def qSlotW (w M v : Nat) : Bool × Nat × Nat :=
  (Nat.blt v (Nat.shiftLeft 1 (Nat.sub w 1)),
    Nat.add (Nat.sub v (Nat.shiftLeft 1 (Nat.sub w 1))) (Nat.sub (Nat.shiftLeft 1 (Nat.sub w 1)) v), M)

/-- The per-degree data (see the module doc). -/
structure DegD where
  /-- half degree `d`: moment blocks `0 … d-1`, scalar blocks `d … d+7` -/
  dH : Nat
  /-- retained coordinates -/
  nc : Nat
  /-- tag code fields and the bound on `t.2.2` of the inverse table -/
  aA : Nat
  aB : Nat
  kC : Nat
  /-- size of the power-sum tables of the one-time checks (`psTab nPS`, `ppsTab nPS`) -/
  nPS : Nat
  /-- coordinate ↦ tag code (16-bit slots, 1024 per numeral) -/
  rtagC : Nat → Nat
  /-- tag code ↦ coordinate or `nc` (16-bit slots, 1024 per numeral) -/
  ridxC : Nat → Nat
  /-- raw dimension, Gram dimension, raw-tensor denominator, moment pivot of block `b` -/
  rdim : Nat → Nat
  gdim : Nat → Nat
  bden : Nat → Nat
  piv : Nat → Nat
  /-- RF records: slot width, numerator record slots / records per numeral, denominator record slots / per numeral -/
  rfW : Nat
  rfR : Nat
  rfPer : Nat
  rfRD : Nat
  rfPerD : Nat
  recC : Nat → Nat
  denC : Nat → Nat
  nRec : Nat
  nDen : Nat
  /-- column tables: scalar block `j`, numeral `c` (16-bit slots `i · rdim + u`, 1024 per numeral) -/
  colC : Nat → Nat → Nat
  /-- raw scalar tags: scalar block `j`, numeral `c` (16-bit slots `code | flag << 15`) -/
  stagC : Nat → Nat → Nat
  /-- classes: number per block; pair stream and class offsets (16-bit slots); keys (32-bit slots, 512 per numeral) -/
  nCls : Nat → Nat
  pairC : Nat → Nat → Nat
  pOffC : Nat → Nat → Nat
  keyC : Nat → Nat → Nat
  /-- moment raw tensors: block `b < dH`, pair key ↦ terms (64-bit slots, 256 per numeral), offsets (16-bit) -/
  momC : Nat → Nat → Nat
  mOffC : Nat → Nat → Nat
  /-- groups: number per block, first class of group `g` (16-bit slots of `gloC b`) -/
  nGrp : Nat → Nat
  gloC : Nat → Nat
  /-- coefficient lists of pseudo-block `pb = 32 b + g`: entries (32-bit, 512 per numeral), number of numerals,
  offsets per coordinate (16-bit slots, `nc + 1`, 1024 per numeral) -/
  eC : Nat → Nat → Nat
  eN : Nat → Nat
  eOffC : Nat → Nat → Nat

namespace DegD

variable (L : DegD)

/-- Tag of coordinate `r`. -/
def rtag (r : Nat) : T3 := decT L.aA L.aB (sAt L.rtagC 16 10 r)

/-- Coordinate of tag `t` (`nc` when `t` is not retained). -/
def ridx (t : T3) : Nat :=
  cond (Nat.blt t.1 (Nat.shiftLeft 1 L.aA) && Nat.blt t.2.1 (Nat.shiftLeft 1 L.aB) && Nat.blt t.2.2 L.kC)
    (sAt L.ridxC 16 10 (encT L.aA L.aB t)) L.nc

/-- Slots of numerator record `k` (`rfR` slots: `lenN, scale, denIdx, num…`). -/
def recSlots (k : Nat) : List Nat := tableSlots L.recC L.rfW L.rfR L.rfPer k

/-- Slots of denominator record `d` (`rfRD` slots: `lenD, scale, den…`). -/
def denSlots (d : Nat) : List Nat := tableSlots L.denC L.rfW L.rfRD L.rfPerD d

/-- Shared-denominator index of record `k`. -/
def denIdx (k : Nat) : Nat := (L.recSlots k).getD 2 0

/-- Numerator of record `k` as `hornerQ` triples (`Nat` decode). -/
def numQ (k : Nat) : List (Bool × Nat × Nat) :=
  (fun s => ((s.drop 3).take (s.getD 0 0)).map (qSlotW L.rfW (s.getD 1 1))) (L.recSlots k)

/-- Denominator polynomial `d` as `hornerQ` triples. -/
def denQ (d : Nat) : List (Bool × Nat × Nat) :=
  (fun s => ((s.drop 2).take (s.getD 0 0)).map (qSlotW L.rfW (s.getD 1 1))) (L.denSlots d)

/-- Integer numerator, its scale; integer denominator, its scale (semantic decode). -/
def numZ (k : Nat) : List Int := (fun s => ((s.drop 3).take (s.getD 0 0)).map (unbiasW L.rfW)) (L.recSlots k)
def numS (k : Nat) : Nat := (L.recSlots k).getD 1 1
def denZ (d : Nat) : List Int := (fun s => ((s.drop 2).take (s.getD 0 0)).map (unbiasW L.rfW)) (L.denSlots d)
def denS (d : Nat) : Nat := (L.denSlots d).getD 1 1

/-- The record `k` (old catalogue shape). -/
def rfRec (k : Nat) : RFRec := ⟨L.numZ k, L.numS k, L.denZ (L.denIdx k), L.denS (L.denIdx k)⟩

/-- Record index of scalar block `j`, column `i`, raw row `u`. -/
def colRec (j i u : Nat) : Nat := sAt (L.colC j) 16 10 (Nat.add (Nat.mul i (L.rdim (Nat.add L.dH j))) u)

/-- Raw scalar tag `(flag, tag)` of scalar block `j`, row `u`. -/
def stag (j u : Nat) : Bool × T3 :=
  (fun c => (Nat.beq (Nat.shiftRight c 15) 1, decT L.aA L.aB (Nat.land c 32767))) (sAt (L.stagC j) 16 10 u)

/-- Pairs `(u, v)` of class `k` of block `b`. -/
def clsPairs (b k : Nat) : List (Nat × Nat) :=
  (fun o0 o1 => (sRun (L.pairC b) 16 10 (Nat.sub o1 o0) o0).map fun x =>
      (Nat.land x 255, Nat.shiftRight x 8))
    (sAt (L.pOffC b) 16 10 k) (sAt (L.pOffC b) 16 10 (Nat.add k 1))

/-- Key of class `k` of block `b`. -/
def clsKey (b k : Nat) : Nat := sAt (L.keyC b) 32 9 k

/-- Old moment source terms `(tag, value)` of pair key `x = u | v << 8` of moment block `b`. -/
def momTerms (b x : Nat) : SP :=
  (fun o0 o1 => (sRun (L.momC b) 64 8 (Nat.sub o1 o0) o0).map fun y =>
      (decT L.aA L.aB (Nat.land y 65535),
        cond (Nat.beq (Nat.land (Nat.shiftRight y 16) 1) 1) (-(Int.ofNat (Nat.shiftRight y 17)))
          (Int.ofNat (Nat.shiftRight y 17))))
    (sAt (L.mOffC b) 16 10 (Nat.add (Nat.land x 255) (Nat.mul (L.rdim b) (Nat.shiftRight x 8))))
    (sAt (L.mOffC b) 16 10 (Nat.add (Nat.add (Nat.land x 255) (Nat.mul (L.rdim b) (Nat.shiftRight x 8))) 1))

/-- Old moment source terms of pair key `x` of moment block `b` in sign-magnitude form. -/
def momSM (b x : Nat) : List (T3 × Bool × Nat) :=
  (fun o0 o1 => (sRun (L.momC b) 64 8 (Nat.sub o1 o0) o0).map fun y =>
      (decT L.aA L.aB (Nat.land y 65535), Nat.beq (Nat.land (Nat.shiftRight y 16) 1) 1, Nat.shiftRight y 17))
    (sAt (L.mOffC b) 16 10 (Nat.add (Nat.land x 255) (Nat.mul (L.rdim b) (Nat.shiftRight x 8))))
    (sAt (L.mOffC b) 16 10 (Nat.add (Nat.add (Nat.land x 255) (Nat.mul (L.rdim b) (Nat.shiftRight x 8))) 1))

/-- Dense accumulators of class key `x` of block `b` (`W`-bit slots; power sums in sign-magnitude form). -/
noncomputable def clsAcc (P PP : List (List (T3 × Bool × Nat))) (W b x : Nat) : Nat × Nat × Nat :=
  cond (Nat.blt b L.dH) (accSM L.ridx L.nc W false 1 (0, 0, 0) (L.momSM b x) (0, 0, 0))
    (rscAcc L.ridx L.nc W P PP (famOf (Nat.sub b L.dH)) (detOf (Nat.sub b L.dH))
      (Nat.beq (Nat.land (Nat.shiftRight x 16) 1) 1) (Nat.beq (Nat.land (Nat.shiftRight x 17) 1) 1)
      (decT L.aA L.aB (Nat.land x 65535)))

/-- The raw-tensor polynomial (scaled by the block denominator) of class key `x` of block `b`. -/
noncomputable def clsPoly (P PP : List SP) (b x : Nat) : SP :=
  cond (Nat.blt b L.dH) (L.momTerms b x)
    (rscZ P PP (famOf (Nat.sub b L.dH)) (detOf (Nat.sub b L.dH)) (Nat.beq (Nat.land (Nat.shiftRight x 16) 1) 1)
      (Nat.beq (Nat.land (Nat.shiftRight x 17) 1) 1) (decT L.aA L.aB (Nat.land x 65535)))

/-- First class of group `g` of block `b`. -/
def glo (b g : Nat) : Nat := slotAt 16 (L.gloC b) g

/-- Entry `(k, neg, m)` from its slot. -/
def decE (x : Nat) : Nat × Bool × Nat := (Nat.land x 4095, Nat.beq (Nat.land (Nat.shiftRight x 12) 1) 1, Nat.shiftRight x 13)

end DegD

/-- Split a list into successive pieces of the given lengths. -/
noncomputable def splitL {α : Type} : List Nat → List α → List (List α) :=
  List.rec (motive := fun _ => List α → List (List α)) (fun _ => []) (fun k _ ih M => M.take k :: ih (M.drop k))

namespace DegD

variable (L : DegD)

/-- Coefficient lists of all coordinates of pseudo-block `pb = 32 b + g`, from one sequential decode. -/
noncomputable def eTab (pb : Nat) : List (List (Nat × Bool × Nat)) :=
  splitL (mkList (fun r => Nat.sub (sAt (L.eOffC pb) 16 10 (Nat.add r 1)) (sAt (L.eOffC pb) 16 10 r)) L.nc)
    ((mkList (fun c => (peel 32 512 (L.eC pb c)).map decE) (L.eN pb)).flatten)

end DegD

end ThomsonCompact.CoeffMap.Deg
