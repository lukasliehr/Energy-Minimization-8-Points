/-! D18 moment blocks (generated by `CoeffMap/Deg/gen/assemble.py`): the raw moment tensors of the old
project (`RawMomentTensors.D18_Fk`, substitution lemma `subst_coordinatePolynomial`) and their coefficients:
the decoded moment terms `momTerms k (min u v + 256 max u v)` are the old sources (`decide`), so the class
coefficients `Cc` of the moment blocks are the raw-tensor coefficients. -/

namespace ThomsonCompact.CoeffMap.Deg.Bridges.D18

open Blueprint.CAP Blueprint.Thomson Blueprint.Thomson.Finite ThomsonCompact.CoeffMap

/-- The old raw moment tensors of the 9 moment blocks. -/
noncomputable def momQ : (k : Fin 9) → Matrix (Fin (9 - k.val + 1)) (Fin (9 - k.val + 1)) Poly3
  | ⟨0, _⟩ => RawMomentTensors.D18_F0.coordinatePolynomial
  | ⟨1, _⟩ => RawMomentTensors.D18_F1.coordinatePolynomial
  | ⟨2, _⟩ => RawMomentTensors.D18_F2.coordinatePolynomial
  | ⟨3, _⟩ => RawMomentTensors.D18_F3.coordinatePolynomial
  | ⟨4, _⟩ => RawMomentTensors.D18_F4.coordinatePolynomial
  | ⟨5, _⟩ => RawMomentTensors.D18_F5.coordinatePolynomial
  | ⟨6, _⟩ => RawMomentTensors.D18_F6.coordinatePolynomial
  | ⟨7, _⟩ => RawMomentTensors.D18_F7.coordinatePolynomial
  | ⟨8, _⟩ => RawMomentTensors.D18_F8.coordinatePolynomial
  | ⟨_ + 9, h⟩ => absurd h (by omega)

theorem hsub : ∀ (k : Fin 9) (u v : Fin (9 - k.val + 1)),
    invariantSubst (momQ k u v) = kernelRPoly k.val u.val v.val := by
  intro k
  fin_cases k
  · exact RawMomentTensors.D18_F0.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F1.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F2.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F3.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F4.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F5.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F6.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F7.subst_coordinatePolynomial
  · exact RawMomentTensors.D18_F8.subst_coordinatePolynomial

theorem src_0_ok : (List.finRange 10).all (fun u => (List.finRange 10).all fun v =>
    decide (ThomsonCompact.CoeffMap.Deg.D18.L.momTerms 0 (Nat.add (min u.val v.val) (Nat.shiftLeft (max u.val v.val) 8)) =
      RawMomentTensors.D18_F0.source u v)) = true := by decide +kernel
theorem den_0 : ThomsonCompact.CoeffMap.Deg.D18.L.bden 0 = RawMomentTensors.D18_F0.denominator := by decide +kernel

