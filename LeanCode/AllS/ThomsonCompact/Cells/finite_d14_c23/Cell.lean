-- the target directions `q r j` are the channel directions of the cell (one check per coordinate)
attribute [local instance] Fintype.decidableForallFintype in
theorem dirOk : ∀ r : Fin 145, ThomsonCompact.Cells.C_finite_d14_c23.B.cb.dirT r + 1 = tagWeight (ThomsonCompact.FixedD14.coordinateTags r) ∧
    (sv (ThomsonCompact.Cells.C_finite_d14_c23.B.cb.dirQ r) : ℚ) = rawRationalLookup (powerSparse (tagWeight (ThomsonCompact.FixedD14.coordinateTags r)))
      (ThomsonCompact.FixedD14.coordinateTags r) := by decide +kernel

theorem dir : ∀ (r : Fin 145) (j : Fin 14), ThomsonCompact.Cells.DegAsm.D14.q r j =
    ((if ThomsonCompact.Cells.C_finite_d14_c23.B.cb.dirT r = j then sv (ThomsonCompact.Cells.C_finite_d14_c23.B.cb.dirQ r) else 0 : ℤ) : ℚ) / 3 := dir_of_tags _ _ dirOk

