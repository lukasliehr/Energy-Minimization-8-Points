theorem shift_row_32 (j : Fin 68) : shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 32 j) (shiftANumerator 32 j)=true := by
  have hj := j.isLt
  exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 32 k) (shiftANumerator 32 k)) 0 68 shift_checked_32_0 j (by omega) (by omega)
theorem lift_row_32 (j : Fin 68) : (liftEquation 32 j).check=true := allBelow_spec _ _ lifts_checked_32 j j.isLt
theorem inverse_row_32 (j : Fin 68) : (inverseEquation 32 j).check=true := by
  have hj := j.isLt
  by_cases h0 : j.val<8
  · exact segment_true (fun k => (inverseEquation 32 k).check) 0 8 inverse_checked_32_0 j (by omega) h0
  by_cases h1 : j.val<16
  · exact segment_true (fun k => (inverseEquation 32 k).check) 8 8 inverse_checked_32_1 j (by omega) h1
  by_cases h2 : j.val<24
  · exact segment_true (fun k => (inverseEquation 32 k).check) 16 8 inverse_checked_32_2 j (by omega) h2
  by_cases h3 : j.val<32
  · exact segment_true (fun k => (inverseEquation 32 k).check) 24 8 inverse_checked_32_3 j (by omega) h3
  by_cases h4 : j.val<40
  · exact segment_true (fun k => (inverseEquation 32 k).check) 32 8 inverse_checked_32_4 j (by omega) h4
  by_cases h5 : j.val<48
  · exact segment_true (fun k => (inverseEquation 32 k).check) 40 8 inverse_checked_32_5 j (by omega) h5
  by_cases h6 : j.val<56
  · exact segment_true (fun k => (inverseEquation 32 k).check) 48 8 inverse_checked_32_6 j (by omega) h6
  by_cases h7 : j.val<64
  · exact segment_true (fun k => (inverseEquation 32 k).check) 56 8 inverse_checked_32_7 j (by omega) h7
  exact segment_true (fun k => (inverseEquation 32 k).check) 64 4 inverse_checked_32_8 j (by omega) (by omega)
