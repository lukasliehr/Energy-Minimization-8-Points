  toQModel_error_le _ _ ThomsonCompact.Cells.C_finite_d14_c23.B.Leaves.herr j.val

/-- residual centres (`2^-128`) and radii (`2^-256`) of the F3b data -/
noncomputable def center (r : Fin 145) (k : Fin 29) : ℚ :=
  (sv (smDec (ThomsonCompact.Floor.slot ThomsonCompact.Cells.C_finite_d14_c23.B.cb.wc (ThomsonCompact.Cells.C_finite_d14_c23.B.cb.cm r) k)) : ℚ) / 2 ^ 128
