theorem shift_row_8 (j : Fin 68) : shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 j) (shiftANumerator 8 j)=true := by
  have hj := j.isLt
  by_cases h0 : j.val<21
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 0 21 shift_checked_8_0 j (by omega) h0
  by_cases h1 : j.val<29
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 21 8 shift_checked_8_1 j (by omega) h1
  by_cases h2 : j.val<37
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 29 8 shift_checked_8_2 j (by omega) h2
  by_cases h3 : j.val<45
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 37 8 shift_checked_8_3 j (by omega) h3
  by_cases h4 : j.val<53
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 45 8 shift_checked_8_4 j (by omega) h4
  by_cases h5 : j.val<61
  · exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 53 8 shift_checked_8_5 j (by omega) h5
  exact segment_true (fun k => shiftCheck shiftDegree (Structure.Factored.HighData.A.numerator 8 k) (shiftANumerator 8 k)) 61 7 shift_checked_8_6 j (by omega) (by omega)
