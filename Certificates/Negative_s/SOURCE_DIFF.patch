+    scale = (-Q * iv.log(iv.mpf(4))).exp()
+    if k == 1:
+        return scale * ell * expm1_over_z(Q * ell)
+    return 2 * scale * ell ** 2 * exp_second_dd(-ell, (Q - 1) * ell)
