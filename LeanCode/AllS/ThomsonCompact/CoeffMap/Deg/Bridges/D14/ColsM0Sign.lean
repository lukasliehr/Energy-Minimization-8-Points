theorem col_m0Sign_8 (a : ℝ) (ha : physical a)
    (hdef : ∀ k, k < ThomsonCompact.CoeffMap.Deg.D14.L.nRec → (ThomsonCompact.CoeffMap.Deg.D14.L.rfRec k).toRatFun.DefinedAt a)
    (i : Fin (scalarBlockDimension .m0Sign 7)) (hi : i.val = 8) :
