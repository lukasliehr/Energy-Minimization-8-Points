theorem moment_jets_columns (j : Fin 15) : productColumnCheck Data.J Data.P Data.M 111 11 32 j.val=true := by
  fin_cases j
  · exact moment_jets.column_0
  · exact moment_jets.column_1
  · exact moment_jets.column_2
  · exact moment_jets.column_3
  · exact moment_jets.column_4
  · exact moment_jets.column_5
  · exact moment_jets.column_6
  · exact moment_jets.column_7
  · exact moment_jets.column_8
  · exact moment_jets.column_9
  · exact moment_jets.column_10
  · exact moment_jets.column_11
  · exact moment_jets.column_12
  · exact moment_jets.column_13
  · exact moment_jets.column_14

theorem moment_jets_identity (a : ℝ) (ha : (5:ℝ)/16≤a) (hb : a<1/3) : Data.J.eval a * Data.P.eval a = Data.M.eval a := by
  have h := product_matrix_sound Data.J Data.P Data.M 111 11 32 a (J_regular a ha hb) (P_regular a ha hb) (M_regular a ha hb) moment_jets_columns
  simpa only [EncodedMatrix.eval_identity, EncodedMatrix.eval_zero] using h

