theorem src_of {n : ℕ} (k : ℕ) (S : Fin n → Fin n → List (Tag × ℤ))
    (h : (List.finRange n).all (fun u => (List.finRange n).all fun v =>
      decide (ThomsonCompact.CoeffMap.Deg.D18.L.momTerms k (Nat.add (min u.val v.val) (Nat.shiftLeft (max u.val v.val) 8)) = S u v)) = true)
    (u v : Fin n) : ThomsonCompact.CoeffMap.Deg.D18.L.momTerms k (Nat.add (min u.val v.val) (Nat.shiftLeft (max u.val v.val) 8)) = S u v := by
  rw [List.all_eq_true] at h
  have h2 := h u (List.mem_finRange u)
  rw [List.all_eq_true] at h2
  exact of_decide_eq_true (h2 v (List.mem_finRange v))

/-- The class coefficient of a moment pair is the coefficient of the old raw tensor. -/
theorem coef_of {n : ℕ} (k : ℕ) (hk : k < ThomsonCompact.CoeffMap.Deg.D18.L.dH) (S : Fin n → Fin n → List (Tag × ℤ)) (den : ℕ)
    (hS : ∀ u v : Fin n, ThomsonCompact.CoeffMap.Deg.D18.L.momTerms k (Nat.add (min u.val v.val) (Nat.shiftLeft (max u.val v.val) 8)) = S u v)
    (hden : ThomsonCompact.CoeffMap.Deg.D18.L.bden k = den) (u v : Fin n) (r : ℕ) :
    MvPolynomial.coeff (tagExponent (ThomsonCompact.CoeffMap.Deg.D18.L.rtag r))
      (RawCatalogue.ratToReal (RawCatalogue.sparsePolynomial (normalizeIntegerRawEntry den (S u v)))) =
      ThomsonCompact.CoeffMap.Deg.D18.L.Cc k r u.val v.val := by
  rw [integerSparsePolynomial_coeff, ← hS u v, ← hden]
  unfold DegD.Cc DegD.kcoef DegD.clsPoly DegD.pairKey
  rw [show Nat.blt k ThomsonCompact.CoeffMap.Deg.D18.L.dH = true from Nat.blt_eq.mpr hk, cond_true, cond_true]

theorem hcoef : ∀ (k : Fin 9) (u v : Fin (9 - k.val + 1)) (r : ℕ),
    MvPolynomial.coeff (tagExponent (ThomsonCompact.CoeffMap.Deg.D18.L.rtag r)) (momQ k u v) = ThomsonCompact.CoeffMap.Deg.D18.L.Cc k.val r u.val v.val := by
  intro k
  fin_cases k
  · exact coef_of 0 (by decide) _ _ (src_of 0 _ src_0_ok) den_0
  · exact coef_of 1 (by decide) _ _ (src_of 1 _ src_1_ok) den_1
  · exact coef_of 2 (by decide) _ _ (src_of 2 _ src_2_ok) den_2
  · exact coef_of 3 (by decide) _ _ (src_of 3 _ src_3_ok) den_3
  · exact coef_of 4 (by decide) _ _ (src_of 4 _ src_4_ok) den_4
  · exact coef_of 5 (by decide) _ _ (src_of 5 _ src_5_ok) den_5
  · exact coef_of 6 (by decide) _ _ (src_of 6 _ src_6_ok) den_6
  · exact coef_of 7 (by decide) _ _ (src_of 7 _ src_7_ok) den_7
  · exact coef_of 8 (by decide) _ _ (src_of 8 _ src_8_ok) den_8

#print axioms hsub
#print axioms hcoef

end ThomsonCompact.CoeffMap.Deg.Bridges.D18
