import ThomsonCompact.CoeffMap.Deg.W0Part
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.Mom
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsM0Plus
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsM0Sign
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsM0Standard
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsM1Even
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsM1Odd
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsMdetPlus
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsMdetSign
import ThomsonCompact.CoeffMap.Deg.Bridges.D18.ColsMdetStandard
import ThomsonCompact.CoeffMap.Deg.OneTime.D18.Checks

/-!
# The D18 inputs of the W0 link (F2h; generated by `CoeffMap/Deg/gen/assemble.py`)

`link : DegLink D18.L 9 pivots`: the table facts (`facts`, from the one-time leaves `OneTime/D18`), the old raw
moment tensors (`Mom`), the scalar columns from the column bridges (`cols`, `Cols*`, via the record bridges
`RF*`) and the one-time block checks. `pivots` is the pivot choice `[0, 1, 0, 1, 0, 0, 0, 0, 0]` of `Interface.D18.pivots`
(definitionally equal; this module does not import the interface).
-/

namespace ThomsonCompact.CoeffMap.Deg.Bridges.D18

open Blueprint.CAP Blueprint.Thomson Blueprint.Thomson.Finite ThomsonCompact.CoeffMap ThomsonCompact.CoeffMap.Deg
open ThomsonCompact.CoeffMap.Deg.Link ThomsonCompact.CoeffMap.Deg.OneTime.D18

/-- Moment pivots `[0, 1, 0, 1, 0, 0, 0, 0, 0]` (as `Interface.D18.pivots`). -/
def pivots : MomentPivots 9 := fun k => ⟨![0, 1, 0, 1, 0, 0, 0, 0, 0] k, by fin_cases k <;> decide⟩

/-- The D18 table facts. -/
theorem facts : LinkFacts D18.L 9 pivots where
  dH := rfl
  gdim_mom := by intro k; fin_cases k <;> rfl
  rdim_mom := by intro k; fin_cases k <;> rfl
  piv := by intro k; fin_cases k <;> rfl
  gdim_sc := by
    intro sb
    cases sb
    · rw [dims_m0Plus]; rfl
    · rw [dims_m0Sign]; rfl
    · rw [dims_m0Standard]; rfl
    · rw [dims_m1Even]; rfl
    · rw [dims_m1Odd]; rfl
    · rw [dims_mdetPlus]; rfl
    · rw [dims_mdetSign]; rfl
    · rw [dims_mdetStandard]; rfl
  bden_sc := by intro sb; cases sb <;> rfl
  pairs := by
    intro sb
    cases sb
    exacts [pairs_ok_0, pairs_ok_1, pairs_ok_2, pairs_ok_3, pairs_ok_4, pairs_ok_5, pairs_ok_6, pairs_ok_7]
  rec0 := rec0_of _ rec01_ok
  rec1 := rec1_of _ rec01_ok
  mom_rat := momRat_of _ 9 rfl momRat_ok
  den_tab := denTab_of _ denTab_ok

/-- The D18 scalar columns from the RF records (wherever every record is defined). -/
theorem cols (a : ℝ) (ha : physical a) (hdef : ∀ k, k < D18.L.nRec → (D18.L.rfRec k).toRatFun.DefinedAt a) :
    ScalarColumnsL D18.L 9 a := by
  intro sb
  cases sb
  · exact ⟨block_m0Plus_0 a ha hdef, fun h => absurd h (by decide)⟩
  · exact ⟨block_m0Sign_0 a ha hdef, fun h => absurd h (by decide)⟩
  · exact ⟨block_m0Standard_0 a ha hdef, fun _ => block_m0Standard_1 a ha hdef⟩
  · exact ⟨block_m1Even_0 a ha hdef, fun h => absurd h (by decide)⟩
  · exact ⟨block_m1Odd_0 a ha hdef, fun h => absurd h (by decide)⟩
  · exact ⟨block_mdetPlus_0 a ha hdef, fun h => absurd h (by decide)⟩
  · exact ⟨block_mdetSign_0 a ha hdef, fun h => absurd h (by decide)⟩
  · exact ⟨block_mdetStandard_0 a ha hdef, fun _ => block_mdetStandard_1 a ha hdef⟩

/-- **Everything D18 supplies to the W0 link.** -/
noncomputable def link : DegLink D18.L 9 pivots := ⟨facts, momQ, hsub, hcoef, cols, checks⟩

#print axioms facts
#print axioms cols

end ThomsonCompact.CoeffMap.Deg.Bridges.D18
